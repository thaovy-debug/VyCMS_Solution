@model IEnumerable<CMS.Data.Entities.Product>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý đánh giá sản phẩm";
}

<div class="admin-wrapper" style="padding: 24px; background-color: #FAF8F5; min-height: 100vh;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold" style="color: #2C2C2C;">Quản Lý Đánh Giá Sản Phẩm</h2>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="background-color: white;">
                <thead style="background-color: #FDFBFA;">
                    <tr>
                        <th class="py-3 px-4 text-secondary fw-semibold">ID</th>
                        <th class="py-3 px-4 text-secondary fw-semibold">Ảnh SP</th>
                        <th class="py-3 px-4 text-secondary fw-semibold">Tên Sản Phẩm</th>
                        <th class="py-3 px-4 text-secondary fw-semibold text-center">Số lượt đánh giá</th>
                        <th class="py-3 px-4 text-secondary fw-semibold text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="py-3 px-4 text-muted fw-bold">@item.Id</td>
                            <td class="py-3 px-4">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px; border: 1px solid #EEE7E1;" />
                                }
                            </td>
                            <td class="py-3 px-4 fw-bold" style="color: #2C2C2C;">@item.Name</td>
                            <td class="py-3 px-4 text-center">
                                @if (item.ProductReviews != null && item.ProductReviews.Count > 0)
                                {
                                    <span class="badge" style="background-color: #E8F5E9; color: #4CAF50; font-size: 13px; padding: 6px 12px; border-radius: 20px;">
                                        @item.ProductReviews.Count đánh giá
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted" style="font-size: 13px; padding: 6px 12px; border-radius: 20px;">
                                        0 đánh giá
                                    </span>
                                }
                            </td>
                            <td class="py-3 px-4 text-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm" style="background-color: #F8F3ED; color: #8B5E3C; font-weight: 600; padding: 6px 16px; border-radius: 8px;">
                                    <i class="bi bi-eye"></i> Xem đánh giá
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
