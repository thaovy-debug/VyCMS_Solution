@model CMS.Data.Entities.Banner

@{
    ViewData["Title"] = "Thêm Banner Mới";
    Layout = "_LayoutAdmin";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --th-bg: #FAF8F5;
        --th-primary: #8B5E3C;
        --th-secondary: #D9C3B0;
        --th-border: #EEE7E1;
        --th-text-main: #2C2C2C;
        --th-text-sub: #8A817C;
        --th-danger: #F44336;
        --th-warning: #FFB300;
        --th-success: #4CAF50;
    }

    .admin-wrapper {
        font-family: 'Inter', sans-serif;
        background-color: var(--th-bg);
        padding: 32px;
        min-height: 100vh;
    }

    .page-title {
        font-size: 42px;
        font-weight: 700;
        color: var(--th-text-main);
        margin-bottom: 0;
    }

    .th-card {
        background-color: #FFFFFF;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.04);
        border: 1px solid var(--th-border);
        margin-bottom: 24px;
        overflow: hidden;
    }

    .th-btn {
        height: 48px;
        border-radius: 12px;
        padding: 0 24px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
        text-decoration: none;
    }

    .th-btn-primary {
        background-color: var(--th-primary);
        color: white;
    }

    .th-btn-primary:hover {
        background-color: #724c30;
        color: white;
    }

    .th-btn-outline {
        background-color: transparent;
        border: 1px solid var(--th-border);
        color: var(--th-text-main);
    }

    .th-btn-outline:hover {
        background-color: #f5f5f5;
    }

    .th-input {
        height: 48px;
        border-radius: 12px;
        border: 1px solid var(--th-border);
        padding: 0 16px;
        font-size: 14px;
        color: var(--th-text-main);
        box-shadow: none !important;
        transition: border-color 0.2s ease;
        width: 100%;
        background-color: #FFFFFF;
    }
    
    .th-input:focus {
        border-color: var(--th-primary);
        outline: none;
    }
    
    .th-input-file {
        padding: 10px 16px;
    }

    .th-form-label {
        font-size: 14px;
        font-weight: 600;
        color: var(--th-text-main);
        margin-bottom: 8px;
    }

    .th-alert-info {
        background-color: #F8F3ED;
        border: 1px solid var(--th-secondary);
        border-radius: 16px;
        padding: 24px;
        color: var(--th-primary);
    }
    
    .th-upload-box {
        background-color: var(--th-bg);
        border: 1px dashed var(--th-secondary);
        border-radius: 16px;
        padding: 24px;
        text-align: center;
    }
</style>

<div class="admin-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title">Thêm Banner Mới</h1>
        <div class="d-flex gap-3">
            <a asp-action="Index" class="th-btn th-btn-outline">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="th-card">
        <div class="card-body p-4 p-md-5">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-4">
                            <label asp-for="Title" class="th-form-label">Tiêu đề Banner <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="th-input" placeholder="Nhập tiêu đề banner..." required />
                            <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label class="th-form-label">Hình ảnh Banner <span class="text-danger">*</span></label>
                            <div class="th-upload-box">
                                <p class="small text-muted mb-3">Bạn có thể <strong>tải ảnh lên từ máy</strong> HOẶC <strong>nhập link ảnh trực tiếp</strong>.</p>
                                
                                <div class="mb-3 text-start">
                                    <label class="th-form-label">1. Tải ảnh từ máy:</label>
                                    <input type="file" name="uploadImage" class="th-input th-input-file" accept="image/*" />
                                </div>
                                
                                <div class="text-center my-3 text-muted fw-bold small">HOẶC</div>
                                
                                <div class="text-start">
                                    <label class="th-form-label">2. Dán link ảnh (URL):</label>
                                    <input asp-for="ImageUrl" class="th-input" placeholder="https://..." />
                                </div>
                            </div>
                            <span asp-validation-for="ImageUrl" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mt-5 d-flex gap-3">
                            <button type="submit" class="th-btn th-btn-primary px-5">
                                <i class="bi bi-floppy"></i> Lưu Banner
                            </button>
                            <a asp-action="Index" class="th-btn th-btn-outline px-4">
                                Hủy bỏ
                            </a>
                        </div>
                    </div>
                    
                    <div class="col-md-4 d-none d-md-block">
                        <div class="th-alert-info">
                            <h6 class="font-weight-bold mb-3"><i class="bi bi-info-circle me-2"></i>Hướng dẫn</h6>
                            <p class="mb-0 small" style="line-height: 1.6;">Tiêu đề giúp bạn quản lý banner dễ dàng hơn. Kích thước ảnh khuyên dùng là <strong>1920x800px</strong> để hiển thị đẹp nhất trên màn hình máy tính.</p>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
