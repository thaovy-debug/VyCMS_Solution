@model CMS.Data.Entities.Product
@* Khai báo Model kiểu Product *@
@{
    Layout = "_LayoutAdmin"; @* Áp dụng layout quản trị Admin *@
}

<div class="container mt-4 mb-5"> @* Vùng chứa chính, margin-top mt-4, bottom mb-5 *@
    <h2 class="text-primary">THÊM SẢN PHẨM MỚI</h2> @* Tiêu đề *@
    <hr /> @* Kẻ đường ngang *@

    <form asp-action="Create" method="post" enctype="multipart/form-data"> @* Form gửi yêu cầu POST hỗ trợ upload ảnh *@
        <div class="row"> @* Dòng lưới chia hai cột *@
            <div class="col-md-8"> @* Cột bên trái chiếm 8/12 cột *@
                <div class="mb-3"> @* Tên sản phẩm *@
                    <label class="form-label fw-bold">Tên sản phẩm:</label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm..." required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3"> @* Mô tả chi tiết *@
                    <label class="form-label fw-bold">Mô tả sản phẩm:</label>
                    <textarea asp-for="Description" class="form-control" rows="5" placeholder="Nhập mô tả chi tiết sản phẩm..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>

            <div class="col-md-4"> @* Cột bên phải chiếm 4/12 cột *@
                <div class="mb-3"> @* Loại sản phẩm *@
                    <label class="form-label fw-bold">Loại sản phẩm:</label>
                    <select asp-for="CategoryProductId" class="form-select" required>
                        <option value="">-- Chọn loại sản phẩm --</option>
                        @if (ViewBag.CategoriesProducts != null)
                        {
                            foreach (var cat in (IEnumerable<CMS.Data.Entities.CategoryProduct>)ViewBag.CategoriesProducts)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="CategoryProductId" class="text-danger small"></span>
                </div>

                <div class="mb-3"> @* Đơn giá *@
                    <label class="form-label fw-bold">Đơn giá (VNĐ):</label>
                    <input asp-for="Price" class="form-control" type="number" step="1000" placeholder="Đơn giá sản phẩm..." required />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="mb-3"> @* Số lượng *@
                    <label class="form-label fw-bold">Số lượng nhập kho:</label>
                    <input asp-for="StockQuantity" class="form-control" type="number" value="10" required />
                    <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                </div>

                <div class="mb-3"> @* Tải lên hình ảnh *@
                    <label class="form-label fw-bold">Hình ảnh sản phẩm (tải từ máy):</label>
                    <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                </div>
            </div>
        </div>

        <div class="mt-3"> @* Các nút thao tác *@
            <button type="submit" class="btn btn-success">Lưu sản phẩm</button>
            <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
        </div>
    </form>
</div>
