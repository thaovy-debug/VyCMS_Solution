@model CMS.Data.Entities.Product
@* Khai báo Model kiểu Product *@
@{
    Layout = "_LayoutAdmin"; @* Áp dụng layout quản trị Admin *@
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --th-bg: #FAF8F5;
        --th-primary: #8B5E3C;
        --th-secondary: #D9C3B0;
        --th-border: #EEE7E1;
        --th-text-main: #2C2C2C;
        --th-text-sub: #8A817C;
        --th-danger: #F44336;
        --th-warning: #FFB300;
        --th-success: #4CAF50;
    }

    .admin-wrapper {
        font-family: 'Inter', sans-serif;
        background-color: var(--th-bg);
        padding: 32px;
        min-height: 100vh;
    }

    .page-title {
        font-size: 32px;
        font-weight: 700;
        color: var(--th-text-main);
        margin-bottom: 24px;
    }

    .th-card {
        background-color: #FFFFFF;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.04);
        border: 1px solid var(--th-border);
        padding: 32px;
    }

    .th-form-label {
        font-size: 14px;
        font-weight: 600;
        color: var(--th-text-main);
        margin-bottom: 8px;
    }

    .th-form-control {
        border-radius: 12px;
        border: 1px solid var(--th-border);
        padding: 12px 16px;
        font-size: 14px;
        color: var(--th-text-main);
        background-color: #FAF8F5;
        transition: all 0.2s ease;
        width: 100%;
        box-shadow: none !important;
    }

    .th-form-control:focus {
        border-color: var(--th-primary);
        background-color: #FFFFFF;
        outline: none;
    }

    .th-form-control::placeholder {
        color: #BDB5AF;
    }

    .th-btn {
        height: 48px;
        border-radius: 12px;
        padding: 0 24px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
        text-decoration: none;
    }

    .th-btn-primary {
        background-color: var(--th-primary);
        color: #FFFFFF;
    }

    .th-btn-primary:hover {
        background-color: #724c30;
        color: #FFFFFF;
    }

    .th-btn-outline {
        background-color: transparent;
        border: 1px solid #BDB5AF;
        color: var(--th-text-sub);
    }

    .th-btn-outline:hover {
        border-color: var(--th-text-main);
        color: var(--th-text-main);
    }

    .th-table th {
        font-size: 14px;
        font-weight: 600;
        color: var(--th-text-sub);
        padding: 16px 12px;
        border-bottom: 1px solid var(--th-border);
        white-space: nowrap;
    }

    .th-table td {
        padding: 16px 12px;
        font-size: 14px;
        color: var(--th-text-main);
        border-bottom: 1px solid var(--th-border);
        vertical-align: middle;
    }
    
    .input-group-text {
        background-color: #F8F3ED;
        border-color: var(--th-border);
        color: var(--th-primary);
        font-weight: 600;
        border-radius: 0;
    }
    
    .input-group .th-form-control:first-child {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }
    
    .input-group .th-form-control:last-child {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
    }
    
    .ck-editor__editable_inline {
        min-height: 400px;
        border-radius: 0 0 12px 12px !important;
    }
    .ck-toolbar {
        border-radius: 12px 12px 0 0 !important;
        background-color: #FDFBFA !important;
        border-color: var(--th-border) !important;
    }
    .ck.ck-editor {
        border-radius: 12px;
        border: 1px solid var(--th-border);
    }
</style>

<div class="admin-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title mb-0">Thêm Sản Phẩm Mới</h1>
        <a asp-action="Index" class="th-btn th-btn-outline">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="th-card">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="col-md-12">
                    <div class="mb-4">
                        <label class="th-form-label">Tên sản phẩm <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="th-form-control" required />
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label class="th-form-label">Giá (VNĐ) <span class="text-danger">*</span></label>
                        <input asp-for="Price" class="th-form-control" type="number" step="1000" required />
                        <span asp-validation-for="Price" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label class="th-form-label">Danh mục <span class="text-danger">*</span></label>
                        <select asp-for="CategoryProductId" class="th-form-control form-select" required>
                            <option value="">-- Chọn danh mục --</option>
                            @if (ViewBag.CategoriesProducts != null)
                            {
                                foreach (var cat in (IEnumerable<CMS.Data.Entities.CategoryProduct>)ViewBag.CategoriesProducts)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CategoryProductId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label class="th-form-label">Kích cỡ (Cùng danh mục, cách nhau bằng dấu phẩy)</label>
                        <input asp-for="Sizes" id="sizesInput" class="th-form-control" placeholder="S,M,L,XL" onkeyup="renderVariantGrid()" />
                        <span asp-validation-for="Sizes" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label class="th-form-label">Hình ảnh sản phẩm (Link ảnh hoặc tải lên từ máy) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="text" name="MainImageLink" class="th-form-control" placeholder="Nhập link ảnh (URL)" />
                            <span class="input-group-text">Hoặc</span>
                            <input type="file" name="MainImageFile" class="th-form-control" accept="image/*" style="background-color: #FFFFFF;" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="th-form-label">Phân loại màu sắc & Ảnh (Tùy chọn)</label>
                        <div id="color-container"></div>
                        <button type="button" class="th-btn th-btn-outline mt-2" onclick="addColor()" style="height: 40px; font-size: 13px;">+ Thêm màu sắc</button>
                        <input type="hidden" name="ColorCount" id="ColorCount" value="0" />
                    </div>
                    
                    <!-- Bảng quản lý Tồn kho Chi tiết -->
                    <div class="mb-4" style="border: 1px solid var(--th-border); border-radius: 16px; overflow: hidden;">
                        <div style="background-color: #FDFBFA; padding: 16px 20px; font-weight: 600; color: var(--th-text-main); border-bottom: 1px solid var(--th-border);">Quản lý Tồn Kho (Màu sắc x Size)</div>
                        <div style="padding: 24px;">
                            <div class="alert alert-info py-2 small" style="background-color: #E3F2FD; border-color: #BBDEFB; color: #0D47A1; border-radius: 8px;">Điền số lượng tồn kho cho từng phân loại bên dưới. Các ô trống sẽ được tính là 0. Số lượng tổng sẽ được tự động tính từ bảng này.</div>
                            <input type="hidden" asp-for="VariantStocks" id="VariantStocks" />
                            
                            <div class="mb-4">
                                <label class="th-form-label">Số lượng nhập kho (Tổng):</label>
                                <input asp-for="StockQuantity" id="StockQuantity" class="th-form-control" type="number" readonly required value="0" style="background-color: #F2F0ED; width: 200px;" />
                                <span asp-validation-for="StockQuantity" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Bảng Tồn kho theo Biến thể -->
                            <div class="table-responsive">
                                <table class="th-table w-100 text-center align-middle" id="variantGrid">
                                    <thead style="background-color: #FDFBFA;">
                                        <tr id="variantGridHeader">
                                            <!-- Rendered by JS -->
                                        </tr>
                                    </thead>
                                    <tbody id="variantGridBody">
                                        <!-- Rendered by JS -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="th-form-label">Ảnh phụ (Tùy chọn)</label>
                        <div id="extra-container"></div>
                        <button type="button" class="th-btn th-btn-outline mt-2" onclick="addExtra()" style="height: 40px; font-size: 13px;">+ Thêm ảnh phụ</button>
                        <input type="hidden" name="ExtraCount" id="ExtraCount" value="0" />
                    </div>

                    <div class="mb-4">
                        <label class="th-form-label">Ảnh Bảng Size (Tùy chọn)</label>
                        <div class="input-group">
                            <input type="text" name="SizeGuideLink" class="th-form-control" placeholder="Nhập link ảnh bảng size (URL)" />
                            <span class="input-group-text">Hoặc</span>
                            <input type="file" name="SizeGuideFile" class="th-form-control" accept="image/*" style="background-color: #FFFFFF;" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="th-form-label">Mô tả chi tiết (Dạng Word)</label>
                        <textarea asp-for="Description" class="th-form-control" id="editor"></textarea>
                        <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch d-flex align-items-center gap-2">
                            <input class="form-check-input m-0" type="checkbox" asp-for="IsNew" />
                            <label class="form-check-label m-0 fw-bold" asp-for="IsNew" style="color: var(--th-text-main);">Đánh dấu là Sản phẩm mới (Sẽ hiện ở mục Hàng mới về)</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top" style="border-color: var(--th-border) !important;">
                <button type="submit" class="th-btn th-btn-primary px-5" onclick="prepareSubmit()">
                    <i class="bi bi-plus-lg"></i> Lưu Thay Đổi
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <!-- Tích hợp CKEditor 5 -->
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
    <script>
        ClassicEditor
            .create(document.querySelector('#editor'))
            .catch(error => {
                console.error(error);
            });

        let colorIndex = 0;
        function addColor() {
            const html = `
                <div class="row mb-3 pb-3 border-bottom align-items-center color-row" style="border-color: var(--th-border) !important;">
                    <div class="col-md-3">
                        <input type="text" name="Colors[${colorIndex}].Name" class="th-form-control color-name" placeholder="Tên màu (VD: Đỏ)" onkeyup="renderVariantGrid()" onchange="renderVariantGrid()" />
                    </div>
                    <div class="col-md-4">
                        <input type="text" name="Colors[${colorIndex}].Link" class="th-form-control" placeholder="Link ảnh URL" />
                    </div>
                    <div class="col-md-4">
                        <input type="file" name="ColorFile_${colorIndex}" class="th-form-control" accept="image/*" style="background-color: #FFFFFF;" />
                    </div>
                    <div class="col-md-1 text-end">
                        <button type="button" class="th-btn" style="background-color: transparent; border: 1px solid var(--th-danger); color: var(--th-danger); height: 42px; padding: 0 16px;" onclick="removeColorRow(this)"><i class="bi bi-trash"></i></button>
                    </div>
                </div>
            `;
            document.getElementById('color-container').insertAdjacentHTML('beforeend', html);
            colorIndex++;
            document.getElementById('ColorCount').value = colorIndex;
            renderVariantGrid();
        }

        function removeColorRow(btn) {
            btn.parentElement.parentElement.remove();
            renderVariantGrid();
        }

        let variantStocks = {};

        function renderVariantGrid() {
            const sizesStr = document.getElementById('sizesInput').value || '';
            const sizes = sizesStr.split(',').map(s => s.trim()).filter(s => s !== '');
            
            // Get colors from inputs
            const colorInputs = document.querySelectorAll('.color-name');
            const colors = [];
            colorInputs.forEach(input => {
                const val = input.value.trim();
                if (val) colors.push({ name: val });
            });
            
            const header = document.getElementById('variantGridHeader');
            const body = document.getElementById('variantGridBody');
            
            if (colors.length === 0 && sizes.length === 0) {
                header.innerHTML = '<th>Không có phân loại</th>';
                body.innerHTML = '<tr><td class="text-muted">Vui lòng thêm Size hoặc Màu sắc</td></tr>';
                updateTotal();
                return;
            }

            // Build Header
            let thHTML = '<th>Tồn Kho</th>';
            if (colors.length > 0) thHTML = '<th>Màu Sắc</th>';
            sizes.forEach(s => {
                thHTML += `<th>Size ${s}</th>`;
            });
            if (sizes.length === 0 && colors.length > 0) thHTML += `<th>Kho</th>`; // Just colors
            header.innerHTML = thHTML;

            // Build Body
            let tbHTML = '';
            if (colors.length > 0) {
                colors.forEach(c => {
                    tbHTML += `<tr><td class="fw-bold">${c.name}</td>`;
                    if (sizes.length > 0) {
                        sizes.forEach(s => {
                            const key = `${c.name}-${s}`;
                            const val = variantStocks[key] || 0;
                            tbHTML += `<td><input type="number" class="th-form-control text-center mx-auto variant-input" style="width: 80px;" data-key="${key}" value="${val}" onchange="updateTotal()" min="0"></td>`;
                        });
                    } else {
                        const key = `${c.name}-`;
                        const val = variantStocks[key] || 0;
                        tbHTML += `<td><input type="number" class="th-form-control text-center mx-auto variant-input" style="width: 80px;" data-key="${key}" value="${val}" onchange="updateTotal()" min="0"></td>`;
                    }
                    tbHTML += `</tr>`;
                });
            } else {
                // Only sizes
                tbHTML += `<tr>`;
                sizes.forEach(s => {
                    const key = `-${s}`;
                    const val = variantStocks[key] || 0;
                    tbHTML += `<td><input type="number" class="th-form-control text-center mx-auto variant-input" style="width: 80px;" data-key="${key}" value="${val}" onchange="updateTotal()" min="0"></td>`;
                });
                tbHTML += `</tr>`;
            }
            body.innerHTML = tbHTML;
            updateTotal();
        }

        function updateTotal() {
            let total = 0;
            const inputs = document.querySelectorAll('.variant-input');
            inputs.forEach(inp => {
                const val = parseInt(inp.value) || 0;
                total += val;
                if(inp.hasAttribute('data-key')) {
                    variantStocks[inp.getAttribute('data-key')] = val; // save state
                }
            });
            const stockInput = document.getElementById('StockQuantity');
            if (stockInput) {
                stockInput.value = total;
            }
        }

        function prepareSubmit() {
            const newVariantStocks = {};
            const inputs = document.querySelectorAll('.variant-input');
            inputs.forEach(inp => {
                const val = parseInt(inp.value) || 0;
                if (val > 0) {
                    newVariantStocks[inp.getAttribute('data-key')] = val;
                }
            });
            document.getElementById('VariantStocks').value = JSON.stringify(newVariantStocks);
        }

        // Init empty grid
        renderVariantGrid();

        let extraIndex = 0;
        function addExtra() {
            const html = `
                <div class="row mb-3 pb-3 border-bottom align-items-center" style="border-color: var(--th-border) !important;">
                    <div class="col-md-6">
                        <input type="text" name="Extras[${extraIndex}].Link" class="th-form-control" placeholder="Link ảnh phụ URL" />
                    </div>
                    <div class="col-md-5">
                        <input type="file" name="ExtraFile_${extraIndex}" class="th-form-control" accept="image/*" style="background-color: #FFFFFF;" />
                    </div>
                    <div class="col-md-1 text-end">
                        <button type="button" class="th-btn" style="background-color: transparent; border: 1px solid var(--th-danger); color: var(--th-danger); height: 42px; padding: 0 16px;" onclick="this.parentElement.parentElement.remove()"><i class="bi bi-trash"></i></button>
                    </div>
                </div>
            `;
            document.getElementById('extra-container').insertAdjacentHTML('beforeend', html);
            extraIndex++;
            document.getElementById('ExtraCount').value = extraIndex;
        }
    </script>
}
