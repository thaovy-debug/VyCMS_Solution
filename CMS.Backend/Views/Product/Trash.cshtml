@model IEnumerable<CMS.Data.Entities.Product>
@{
    Layout = "_LayoutAdmin";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --th-bg: #FAF8F5;
        --th-primary: #8B5E3C;
        --th-secondary: #D9C3B0;
        --th-border: #EEE7E1;
        --th-text-main: #2C2C2C;
        --th-text-sub: #8A817C;
        --th-danger: #F44336;
        --th-warning: #FFB300;
        --th-success: #4CAF50;
    }

    .admin-wrapper {
        font-family: 'Inter', sans-serif;
        background-color: var(--th-bg);
        padding: 32px;
        min-height: 100vh;
    }

    .page-title {
        font-size: 32px;
        font-weight: 700;
        color: var(--th-text-main);
        margin-bottom: 0;
    }

    .th-card {
        background-color: #FFFFFF;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.04);
        border: 1px solid var(--th-border);
        overflow: hidden;
    }

    .th-table {
        width: 100%;
        border-collapse: collapse;
    }

    .th-table th {
        background-color: #FDFBFA;
        padding: 16px 24px;
        font-size: 13px;
        font-weight: 600;
        color: var(--th-text-sub);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid var(--th-border);
        white-space: nowrap;
    }

    .th-table td {
        padding: 16px 24px;
        vertical-align: middle;
        border-bottom: 1px solid var(--th-border);
        color: var(--th-text-main);
        font-size: 14px;
    }

    .th-table tbody tr {
        transition: background-color 0.2s ease;
    }

    .th-table tbody tr:hover {
        background-color: #FAF8F5;
    }

    .th-btn {
        height: 40px;
        border-radius: 10px;
        padding: 0 20px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
        text-decoration: none;
    }

    .th-btn-outline {
        background-color: transparent;
        border: 1px solid #BDB5AF;
        color: var(--th-text-sub);
    }

    .th-btn-outline:hover {
        border-color: var(--th-text-main);
        color: var(--th-text-main);
    }
    
    .th-btn-success {
        background-color: var(--th-success);
        color: white;
    }
    
    .th-btn-danger {
        background-color: var(--th-danger);
        color: white;
    }

    .th-btn-action {
        height: 36px;
        width: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        background-color: transparent;
    }

    .th-btn-restore {
        border: 1px solid var(--th-success);
        color: var(--th-success);
    }

    .th-btn-restore:hover {
        background-color: var(--th-success);
        color: #FFFFFF;
    }

    .th-btn-del {
        border: 1px solid var(--th-danger);
        color: var(--th-danger);
    }

    .th-btn-del:hover {
        background-color: var(--th-danger);
        color: #FFFFFF;
    }
</style>

<div class="admin-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title text-danger"><i class="bi bi-trash3 me-2"></i> Thùng rác Sản phẩm</h1>
        <a asp-action="Index" class="th-btn th-btn-outline">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mb-4" style="border-radius: 12px;">@TempData["ErrorMessage"]</div>
    }

    <div class="th-card">
        <div class="d-flex align-items-center p-3 border-bottom" style="background-color: #FDFBFA; border-color: var(--th-border) !important;">
            <div class="form-check m-0 me-4 d-flex align-items-center gap-2">
                <input type="checkbox" id="selectAll" class="form-check-input m-0 shadow-sm" style="width: 20px; height: 20px; cursor: pointer;" />
                <label class="form-check-label fw-bold m-0" style="color: var(--th-text-main); font-size: 15px; cursor: pointer;" for="selectAll">Chọn tất cả</label>
            </div>
            <button id="btnBulkRestore" class="th-btn th-btn-success d-none m-0 me-2" style="height: 40px; padding: 0 16px;">
                <i class="bi bi-arrow-counterclockwise"></i> Khôi phục đã chọn
            </button>
            <button id="btnBulkForceDelete" class="th-btn th-btn-danger d-none m-0" style="height: 40px; padding: 0 16px;">
                <i class="bi bi-x-circle"></i> Xóa vĩnh viễn đã chọn
            </button>
        </div>

        <div class="table-responsive">
            <table class="th-table">
                <thead>
                    <tr>
                        <th style="width: 40px;"></th>
                        <th style="width: 80px;">ID</th>
                        <th style="width: 100px;">Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Loại sản phẩm</th>
                        <th style="width: 150px; text-align: right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><input type="checkbox" class="form-check-input chk-item m-0 shadow-sm" style="width: 20px; height: 20px; cursor: pointer;" value="@item.Id" /></td>
                            <td class="fw-bold text-muted">#@item.Id</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px; border: 1px solid var(--th-border); filter: grayscale(100%); opacity: 0.8;" />
                                }
                                else
                                {
                                    <div style="width: 60px; height: 60px; background-color: #FDFBFA; border-radius: 8px; border: 1px dashed var(--th-border); display: flex; align-items: center; justify-content: center;">
                                        <i class="bi bi-image text-muted"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <div style="font-weight: 600; font-size: 15px; color: var(--th-text-sub); text-decoration: line-through;">@item.Name</div>
                            </td>
                            <td>
                                <span style="background-color: #F8F3ED; color: var(--th-primary); padding: 4px 12px; border-radius: 6px; font-size: 12px; font-weight: 600;">
                                    @item.CategoryProduct?.Name
                                </span>
                            </td>
                            <td style="text-align: right;">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a asp-action="Restore" asp-route-id="@item.Id" class="th-btn-action th-btn-restore" title="Khôi phục">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </a>
                                    <a asp-action="ForceDelete" asp-route-id="@item.Id" class="th-btn-action th-btn-del" title="Xóa vĩnh viễn" onclick="return confirm('Bạn có chắc chắn muốn xóa vĩnh viễn sản phẩm này?')">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        @if (!Model.Any())
        {
            <div class="text-center p-5">
                <i class="bi bi-inbox text-muted" style="font-size: 48px; opacity: 0.3;"></i>
                <p class="mt-3 text-muted" style="font-weight: 500;">Thùng rác trống</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#selectAll').change(function () {
                $('.chk-item').prop('checked', $(this).prop('checked'));
                toggleBulkBtns();
            });

            $('.chk-item').change(function () {
                if ($('.chk-item:checked').length === $('.chk-item').length) {
                    $('#selectAll').prop('checked', true);
                } else {
                    $('#selectAll').prop('checked', false);
                }
                toggleBulkBtns();
            });

            function toggleBulkBtns() {
                if ($('.chk-item:checked').length > 0) {
                    $('#btnBulkRestore, #btnBulkForceDelete').removeClass('d-none');
                } else {
                    $('#btnBulkRestore, #btnBulkForceDelete').addClass('d-none');
                }
            }

            $('#btnBulkRestore').click(function () {
                if (!confirm("Khôi phục các mục đã chọn?")) return;
                var selectedIds = [];
                $('.chk-item:checked').each(function () { selectedIds.push($(this).val()); });
                
                $.post('/Product/BulkRestore', { ids: selectedIds }, function (res) {
                    if (res.success) location.reload();
                    else alert(res.message);
                });
            });

            $('#btnBulkForceDelete').click(function () {
                if (!confirm("CẢNH BÁO: Hành động này sẽ xóa vĩnh viễn các mục đã chọn và không thể khôi phục! Tiếp tục?")) return;
                var selectedIds = [];
                $('.chk-item:checked').each(function () { selectedIds.push($(this).val()); });
                
                $.post('/Product/BulkForceDelete', { ids: selectedIds }, function (res) {
                    if (res.success) location.reload();
                    else alert(res.message);
                });
            });
        });
    </script>
}
