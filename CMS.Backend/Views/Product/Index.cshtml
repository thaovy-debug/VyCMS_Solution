@*
Sinh vien:Nguyễn Quỳnh Thảo Vy
Ma sv: 2123110158
Lop:CCQ2311E
Mo ta: Giao diện quản lý danh sách sản phẩm, hiển thị chi tiết hình ảnh, đơn giá, số lượng tồn kho (Đã áp dụng Layout Admin), 
Ngay thuc hien: 15/05/2026
*@
@model IEnumerable<CMS.Data.Entities.Product>
@* Khai báo Model nhận danh sách thực thể Product *@
@{
    Layout = "_LayoutAdmin"; @* Áp dụng layout quản trị Admin *@
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --th-bg: #FAF8F5;
        --th-primary: #8B5E3C;
        --th-secondary: #D9C3B0;
        --th-border: #EEE7E1;
        --th-text-main: #2C2C2C;
        --th-text-sub: #8A817C;
        --th-success: #4CAF50;
        --th-danger: #F44336;
        --th-warning: #FFB300;
        --th-info: #2196F3;
        --th-purple: #9C27B0;
    }

    .admin-wrapper {
        font-family: 'Inter', sans-serif;
        background-color: var(--th-bg);
        padding: 32px;
        min-height: 100vh;
    }

    .page-title {
        font-size: 42px;
        font-weight: 700;
        color: var(--th-text-main);
        margin-bottom: 0;
    }

    /* Card styling */
    .th-card {
        background-color: #FFFFFF;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.04);
        border: 1px solid var(--th-border);
        margin-bottom: 24px;
        overflow: hidden;
    }

    /* Filter Bar */
    .th-filter-bar {
        padding: 24px;
        display: flex;
        gap: 16px;
        align-items: center;
        flex-wrap: wrap;
    }

    .th-input {
        height: 48px;
        border-radius: 12px;
        border: 1px solid var(--th-border);
        padding: 0 16px;
        font-size: 14px;
        color: var(--th-text-main);
        box-shadow: none !important;
    }
    
    .th-input:focus {
        border-color: var(--th-primary);
    }

    .th-btn {
        height: 48px;
        border-radius: 12px;
        padding: 0 24px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
    }

    .th-btn-primary {
        background-color: var(--th-primary);
        color: white;
    }

    .th-btn-primary:hover {
        background-color: #724c30;
        color: white;
    }

    .th-btn-outline {
        background-color: transparent;
        border: 1px solid var(--th-border);
        color: var(--th-text-main);
    }

    .th-btn-outline:hover {
        background-color: #f5f5f5;
    }

    /* Table */
    .th-table-container {
        overflow-x: auto;
    }

    .th-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .th-table th {
        font-size: 14px;
        font-weight: 600;
        color: var(--th-text-sub);
        padding: 16px 12px;
        border-bottom: 1px solid var(--th-border);
        white-space: nowrap;
        text-align: left;
    }

    .th-table td {
        padding: 12px;
        font-size: 13px;
        color: var(--th-text-main);
        border-bottom: 1px solid var(--th-border);
        vertical-align: middle;
        background: #FFFFFF;
    }

    .th-table tr {
        height: 96px;
        transition: background-color 0.2s ease;
    }

    .th-table tbody tr:hover td {
        background-color: #FDFBFA;
    }

    /* Product Details */
    .th-product-img {
        width: 90px;
        height: 90px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid var(--th-border);
    }

    .th-product-name {
        font-size: 15px;
        font-weight: 700;
        color: var(--th-text-main);
        margin-bottom: 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .th-product-desc {
        font-size: 13px;
        color: var(--th-text-sub);
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Status Toggles */
    .th-status-stack {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .th-toggle {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .th-switch {
        position: relative;
        display: inline-block;
        width: 44px;
        height: 24px;
        flex-shrink: 0;
        margin: 0;
    }

    .th-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .th-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #E0E0E0;
        transition: .4s;
        border-radius: 24px;
    }

    .th-slider:before {
        position: absolute;
        content: "";
        height: 18px;
        width: 18px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: .4s;
        border-radius: 50%;
    }

    .th-switch input:checked + .th-slider:before {
        transform: translateX(20px);
    }

    .th-switch input.toggle-new:checked + .th-slider { background-color: var(--th-info); }
    .th-switch input.toggle-hot:checked + .th-slider { background-color: var(--th-warning); }
    .th-switch input.toggle-visible:checked + .th-slider { background-color: var(--th-success); }
    .th-switch input.toggle-sale:checked + .th-slider { background-color: var(--th-purple); }

    .th-toggle-label {
        font-size: 13px;
        font-weight: 500;
        color: var(--th-text-sub);
        margin: 0;
        cursor: pointer;
    }
    
    .th-switch input:checked ~ .th-toggle-label {
        color: var(--th-text-main);
    }

    /* Actions */
    .th-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: stretch;
    }

    .th-btn-action {
        height: 32px;
        padding: 0 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        transition: all 0.2s ease;
        text-decoration: none;
        width: 100%;
    }

    .th-btn-view {
        border: 1px solid var(--th-text-sub);
        color: var(--th-text-sub);
    }
    .th-btn-view:hover { background: var(--th-text-sub); color: white; }

    .th-btn-edit {
        border: 1px solid var(--th-warning);
        color: var(--th-warning);
    }
    .th-btn-edit:hover { background: var(--th-warning); color: white; }

    .th-btn-delete {
        border: 1px solid var(--th-danger);
        color: var(--th-danger);
    }
    .th-btn-delete:hover { background: var(--th-danger); color: white; }

    .discount-badge {
        background-color: #FFF3E0;
        color: #E65100;
        border: 1px solid #FFE0B2;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 700;
        margin-left: 8px;
    }
</style>

<div class="admin-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title">Quản lý Sản phẩm</h1>
        <div class="d-flex gap-3">
            <button id="btnBulkDelete" class="th-btn th-btn-outline" style="color: var(--th-danger); border-color: var(--th-danger);" class="d-none">
                <i class="bi bi-trash"></i> Xóa mục đã chọn
            </button>
            <a asp-action="Trash" class="th-btn th-btn-outline">
                <i class="bi bi-archive"></i> Thùng rác
            </a>
            <a asp-action="Create" class="th-btn th-btn-primary">
                <i class="bi bi-plus-lg"></i> Thêm sản phẩm mới
            </a>
        </div>
    </div>

    <div class="th-card">
        <form method="get" asp-action="Index">
            <div class="th-filter-bar">
                <div style="flex: 1; min-width: 250px;">
                    <input type="text" name="searchString" class="form-control th-input w-100" placeholder="Tìm kiếm tên sản phẩm..." value="@ViewBag.CurrentSearch" />
                </div>
                <div style="width: 200px;">
                    <select name="categoryId" class="form-select th-input">
                        <option value="">-- Tất cả danh mục --</option>
                        @if (ViewBag.CategoriesProducts != null)
                        {
                            foreach (var cat in ViewBag.CategoriesProducts)
                            {
                                if (ViewBag.CurrentCategory != null && ViewBag.CurrentCategory == cat.Id)
                                {
                                    <option value="@cat.Id" selected>@cat.Name</option>
                                }
                                else
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div style="width: 220px;">
                    <select name="stockStatus" class="form-select th-input">
                        @{
                            var currentStatus = ViewBag.CurrentStockStatus as int?;
                        }
                        @if (!currentStatus.HasValue) { <option value="" selected>-- Tình trạng kho --</option> } else { <option value="">-- Tình trạng kho --</option> }
                        @if (currentStatus == 1) { <option value="1" selected>Còn hàng an toàn (&gt;5)</option> } else { <option value="1">Còn hàng an toàn (&gt;5)</option> }
                        @if (currentStatus == 2) { <option value="2" selected>Sắp hết hàng (&lt;=5)</option> } else { <option value="2">Sắp hết hàng (&lt;=5)</option> }
                        @if (currentStatus == 3) { <option value="3" selected>Đã hết hàng (0)</option> } else { <option value="3">Đã hết hàng (0)</option> }
                    </select>
                </div>
                <button type="submit" class="th-btn th-btn-primary"><i class="bi bi-funnel"></i> Lọc</button>
                <a asp-action="Index" class="th-btn th-btn-outline"><i class="bi bi-arrow-counterclockwise"></i> Đặt lại</a>
            </div>
        </form>
    </div>

    <div class="th-card th-table-container">
        <table class="th-table">
            <thead>
                <tr>
                    <th style="width:40px; text-align:center;"><input type="checkbox" id="selectAll" class="form-check-input" style="width:16px;height:16px;" /></th>
                    <th style="width:50px">ID</th>
                    <th style="width:90px">Hình ảnh</th>
                    <th>Sản phẩm</th>
                    <th style="width:100px">Danh mục</th>
                    <th style="width:110px">Đơn giá</th>
                    <th style="width:110px">Giá Sale</th>
                    <th style="width:80px">Tồn kho</th>
                    <th style="width:130px">Trạng thái</th>
                    <th style="width:80px; text-align:center;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="text-align:center;"><input type="checkbox" class="form-check-input chk-item" style="width:16px;height:16px;" value="@item.Id" /></td>
                        <td class="fw-semibold text-muted">#@item.Id</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Name" class="th-product-img" />
                            }
                            else
                            {
                                <div class="th-product-img d-flex align-items-center justify-content-center bg-light text-muted small">N/A</div>
                            }
                        </td>
                        <td>
                            <div class="th-product-name" title="@item.Name">@item.Name</div>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <div class="th-product-desc" title="@item.Description">@item.Description</div>
                            }
                        </td>
                        <td><span class="badge bg-light text-dark border">@item.CategoryProduct?.Name</span></td>
                        <td class="fw-bold" style="color: var(--th-text-main);">@item.Price.ToString("N0") VNĐ</td>
                        <td class="fw-bold" style="color: var(--th-danger);" id="salePrice_@item.Id">
                            @if (item.DiscountPercent > 0)
                            {
                                var salePrice = Math.Round((decimal)item.Price * (100 - item.DiscountPercent) / 100);
                                <text>@salePrice.ToString("N0") VNĐ</text>
                            }
                            else
                            {
                                <span class="text-muted fw-normal" style="font-size: 13px;">Không</span>
                            }
                        </td>
                        <td>
                            @if (item.StockQuantity <= 5)
                            {
                                <span style="color: var(--th-danger); font-weight: 600; font-size: 14px;">@item.StockQuantity (Thấp)</span>
                            }
                            else
                            {
                                <span style="color: var(--th-success); font-weight: 600; font-size: 14px;">@item.StockQuantity</span>
                            }
                        </td>
                        <td>
                            <div class="th-status-stack">
                                <label class="th-toggle">
                                    <div class="th-switch">
                                        <input type="checkbox" class="chk-new toggle-new" data-id="@item.Id" @(item.IsNew ? "checked" : "")>
                                        <span class="th-slider"></span>
                                    </div>
                                    <span class="th-toggle-label">Mới</span>
                                </label>
                                <label class="th-toggle">
                                    <div class="th-switch">
                                        <input type="checkbox" class="chk-hot toggle-hot" data-id="@item.Id" @(item.IsHot ? "checked" : "")>
                                        <span class="th-slider"></span>
                                    </div>
                                    <span class="th-toggle-label">Bán chạy</span>
                                </label>
                                <label class="th-toggle">
                                    <div class="th-switch">
                                        <input type="checkbox" class="chk-visible toggle-visible" data-id="@item.Id" @(item.IsVisible ? "checked" : "")>
                                        <span class="th-slider"></span>
                                    </div>
                                    <span class="th-toggle-label">Hiển thị web</span>
                                </label>
                                <label class="th-toggle">
                                    <div class="th-switch">
                                        <input type="checkbox" class="chk-sale toggle-sale" data-id="@item.Id" data-price="@item.Price" @(item.DiscountPercent > 0 ? "checked" : "")>
                                        <span class="th-slider"></span>
                                    </div>
                                    <span class="th-toggle-label">Khuyến mãi <span class="discount-badge @(item.DiscountPercent > 0 ? "" : "d-none")">@item.DiscountPercent%</span></span>
                                </label>
                            </div>
                        </td>
                        <td>
                            <div class="th-actions justify-content-center">
                                <button type="button" class="th-btn-action th-btn-view btn-view-stock" data-id="@item.Id" data-name="@item.Name" data-category="@(item.CategoryProduct?.Name ?? "")" data-price="@item.Price" data-stock="@item.StockQuantity" data-image="@(string.IsNullOrEmpty(item.ImageUrl) ? "" : item.ImageUrl.Split(',')[0])" data-sizes="@item.Sizes" data-colors='@(item.Colors != null ? Html.Raw(item.Colors.Replace("'", "&#39;")) : "")' data-variantstocks='@(item.VariantStocks != null ? Html.Raw(item.VariantStocks.Replace("'", "&#39;")) : "")'>Xem</button>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="th-btn-action th-btn-edit">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="th-btn-action th-btn-delete" onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm @item.Name không?')">Xóa</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div> @* Đóng khối py-4 *@

<!-- Modal Xem Chi Tiết Tồn Kho -->
<div class="modal fade" id="stockDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 12px; border: none; overflow: hidden;">
            <div class="modal-header" style="border-bottom: 1px dashed var(--th-border); padding: 24px;">
                <h4 class="modal-title" style="color: #6d4229; font-weight: 700; font-family: 'Times New Roman', serif;">Chi tiết Tồn kho #<span id="modalProductId"></span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 24px;">
                <div class="row">
                    <div class="col-md-4 text-center">
                        <img id="modalProductImage" src="" alt="Sản phẩm" style="width: 100%; max-height: 400px; border-radius: 8px; object-fit: cover;" />
                    </div>
                    <div class="col-md-8">
                        <h5 id="modalProductName" style="font-weight: 700; color: #333; margin-bottom: 16px;"></h5>
                        <p style="margin-bottom: 8px;"><strong>Danh mục:</strong> <span id="modalProductCategory"></span></p>
                        <p style="margin-bottom: 8px;"><strong>Giá:</strong> <span id="modalProductPrice"></span> VNĐ</p>
                        <p style="margin-bottom: 24px;"><strong>Tổng tồn kho:</strong> <span id="modalProductTotalStock" style="color: #d32f2f; font-weight: 700; font-size: 1.1rem;"></span></p>
                        
                        <p style="font-weight: 600; margin-bottom: 12px;">Tồn kho chi tiết (Phân loại x Size)</p>
                        <div class="table-responsive">
                            <table class="table table-bordered text-center" style="vertical-align: middle;">
                                <thead style="background-color: #fafafa;">
                                    <tr id="modalStockTableHeader">
                                        <!-- Rendered by JS -->
                                    </tr>
                                </thead>
                                <tbody id="modalStockTableBody">
                                    <!-- Rendered by JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nhập Giá Khuyến Mãi -->
<div class="modal fade" id="salePriceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-primary">Cập nhật Giá Khuyến Mãi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Giá gốc của sản phẩm: <strong id="saleModalOriginalPrice" class="text-danger">0</strong> VNĐ</p>
                <div class="mb-3">
                    <label class="form-label fw-bold">Nhập Giá sau khi giảm (VNĐ):</label>
                    <input type="number" class="form-control" id="saleModalInputPrice" min="0" step="1000" placeholder="Ví dụ: 250000">
                    <small class="text-muted">Hệ thống sẽ tự động tính ra phần trăm (%) giảm giá.</small>
                </div>
                <input type="hidden" id="saleModalProductId">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-primary" id="btnSaveSalePrice">Lưu Khuyến Mãi</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Xem chi tiết tồn kho bằng Modal
            $('.btn-view-stock').click(function () {
                var btn = $(this);
                var id = btn.data('id');
                var name = btn.data('name');
                var category = btn.data('category');
                var price = parseFloat(btn.data('price')).toLocaleString('vi-VN');
                var totalStock = btn.data('stock');
                var image = btn.data('image');
                var sizesStr = btn.data('sizes') || '';
                var colorsStr = btn.data('colors');
                var variantStocksStr = btn.data('variantstocks');
                
                $('#modalProductId').text(id);
                $('#modalProductName').text(name);
                $('#modalProductCategory').text(category);
                $('#modalProductPrice').text(price);
                $('#modalProductTotalStock').text(totalStock);
                
                if (image) {
                    $('#modalProductImage').attr('src', image).show();
                } else {
                    $('#modalProductImage').hide();
                }

                var sizes = sizesStr ? sizesStr.split(',').map(s => s.trim()) : [];
                var colors = [];
                var variantStocks = {};
                
                try { if (colorsStr) colors = typeof colorsStr === 'string' ? JSON.parse(colorsStr) : colorsStr; } catch (e) { console.error(e); }
                try { if (variantStocksStr) variantStocks = typeof variantStocksStr === 'string' ? JSON.parse(variantStocksStr) : variantStocksStr; } catch (e) { console.error(e); }

                var thead = '<th>Màu sắc</th>';
                sizes.forEach(function(s) {
                    thead += '<th>Size ' + s + '</th>';
                });
                if (sizes.length === 0) thead += '<th>Số lượng</th>';
                $('#modalStockTableHeader').html(thead);

                var tbody = '';
                if (colors && colors.length > 0) {
                    colors.forEach(function(c) {
                        tbody += '<tr>';
                        tbody += '<td><div class="d-flex align-items-center justify-content-center">' + (c.image ? '<img src="'+c.image+'" style="width: 30px; height: 30px; object-fit: cover; border-radius: 4px; margin-right: 8px; border: 1px solid #ddd;"/>' : '') + '<strong>' + c.name + '</strong></div></td>';
                        if (sizes.length > 0) {
                            sizes.forEach(function(s) {
                                var key = c.name + '-' + s;
                                var stock = variantStocks[key] || 0;
                                tbody += '<td style="color: #2e7d32; font-weight: 700;">' + stock + '</td>';
                            });
                        } else {
                            var key = c.name + '-';
                            var stock = variantStocks[key] || 0;
                            tbody += '<td style="color: #2e7d32; font-weight: 700;">' + stock + '</td>';
                        }
                        tbody += '</tr>';
                    });
                } else {
                    if (sizes.length > 0) {
                        tbody += '<tr><td>Mặc định</td>';
                        sizes.forEach(function(s) {
                            var key = '-' + s;
                            var stock = variantStocks[key] || 0;
                            tbody += '<td style="color: #2e7d32; font-weight: 700;">' + stock + '</td>';
                        });
                        tbody += '</tr>';
                    } else {
                        tbody += '<tr><td>Mặc định</td><td style="color: #2e7d32; font-weight: 700;">' + totalStock + '</td></tr>';
                    }
                }
                $('#modalStockTableBody').html(tbody);
                
                var stockModal = new bootstrap.Modal(document.getElementById('stockDetailModal'));
                stockModal.show();
            });
            // Xử lý bật/tắt Hàng mới
            $('.chk-new').change(function () {
                var id = $(this).data('id');
                var isChecked = $(this).is(':checked');
                $.post('/Product/ToggleNew', { id: id, isNew: isChecked }, function (res) {
                    if (!res.success) alert("Lỗi khi cập nhật trạng thái Sản phẩm mới!");
                });
            });

            // Xử lý bật/tắt Bán chạy
            $('.chk-hot').change(function () {
                var id = $(this).data('id');
                var isChecked = $(this).is(':checked');
                $.post('/Product/ToggleHot', { id: id, isHot: isChecked }, function (res) {
                    if (!res.success) alert("Lỗi khi cập nhật trạng thái Bán chạy!");
                });
            });

            // Xử lý bật/tắt Hiển thị
            $('.chk-visible').change(function () {
                var id = $(this).data('id');
                var isChecked = $(this).is(':checked');
                $.post('/Product/ToggleVisible', { id: id, isVisible: isChecked }, function (res) {
                    if (!res.success) alert("Lỗi khi cập nhật trạng thái Hiển thị!");
                });
            });

            // Xử lý bật/tắt Sale
            var currentSaleCheckbox = null;
            var isModalSaved = false;

            $('.chk-sale').change(function () {
                currentSaleCheckbox = $(this);
                var id = $(this).data('id');
                var price = $(this).data('price');
                var isChecked = $(this).is(':checked');

                if (isChecked) {
                    // Mở Modal
                    isModalSaved = false;
                    $('#saleModalProductId').val(id);
                    $('#saleModalOriginalPrice').text(price.toLocaleString('vi-VN'));
                    $('#saleModalInputPrice').val('');
                    
                    var saleModal = new bootstrap.Modal(document.getElementById('salePriceModal'));
                    saleModal.show();
                } else {
                    // Tắt Sale
                    $.post('/Product/UpdateSale', { id: id, isSale: false, salePrice: null }, function (res) {
                        if (res.success) {
                            currentSaleCheckbox.siblings('label').find('.discount-badge').addClass('d-none');
                            $('#salePrice_' + id).html('<span class="text-muted small">Không</span>');
                        } else {
                            alert("Lỗi khi tắt khuyến mãi!");
                            currentSaleCheckbox.prop('checked', true); // Trả lại trạng thái
                        }
                    });
                }
            });

            // Khi đóng Modal mà chưa Save
            $('#salePriceModal').on('hidden.bs.modal', function () {
                if (!isModalSaved && currentSaleCheckbox != null && currentSaleCheckbox.is(':checked')) {
                    currentSaleCheckbox.prop('checked', false);
                }
            });

            // Khi bấm Lưu trong Modal
            $('#btnSaveSalePrice').click(function () {
                var id = $('#saleModalProductId').val();
                var salePrice = $('#saleModalInputPrice').val();
                
                if (!salePrice || isNaN(salePrice) || Number(salePrice) < 0) {
                    alert("Vui lòng nhập giá khuyến mãi hợp lệ!");
                    return;
                }

                $.post('/Product/UpdateSale', { id: id, isSale: true, salePrice: salePrice }, function (res) {
                    if (res.success) {
                        isModalSaved = true;
                        var badge = currentSaleCheckbox.siblings('label').find('.discount-badge');
                        badge.removeClass('d-none').text(res.discountPercent + '%');
                        
                        $('#salePrice_' + id).text(Number(salePrice).toLocaleString('vi-VN') + ' đ');
                        
                        var modalEl = document.getElementById('salePriceModal');
                        var modalIns = bootstrap.Modal.getInstance(modalEl);
                        modalIns.hide();
                    } else {
                        alert("Lỗi khi lưu thông tin khuyến mãi!");
                    }
                });
            });

            // Chọn tất cả
            $('#selectAll').change(function () {
                $('.chk-item').prop('checked', $(this).prop('checked'));
                toggleBulkDeleteBtn();
            });

            $('.chk-item').change(function () {
                if ($('.chk-item:checked').length === $('.chk-item').length) {
                    $('#selectAll').prop('checked', true);
                } else {
                    $('#selectAll').prop('checked', false);
                }
                toggleBulkDeleteBtn();
            });

            function toggleBulkDeleteBtn() {
                if ($('.chk-item:checked').length > 0) {
                    $('#btnBulkDelete').removeClass('d-none');
                } else {
                    $('#btnBulkDelete').addClass('d-none');
                }
            }

            $('#btnBulkDelete').click(function () {
                if (!confirm("Bạn có chắc chắn muốn xóa (vào thùng rác) các mục đã chọn không?")) return;
                var selectedIds = [];
                $('.chk-item:checked').each(function () {
                    selectedIds.push($(this).val());
                });
                
                $.post('/Product/BulkDelete', { ids: selectedIds }, function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert(res.message || "Đã xảy ra lỗi");
                    }
                });
            });
        });
    </script>
}
