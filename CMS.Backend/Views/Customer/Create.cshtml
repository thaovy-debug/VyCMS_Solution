@*
Sinh vien:Nguyễn Quỳnh Thảo Vy
Ma sv: 2123110158
Lop:CCQ2311E
Mo ta: Giao diện thêm mới khách hàng vào hệ thống (Đã áp dụng Layout Admin), 
Ngay thuc hien: 15/05/2026
*@
@model CMS.Data.Entities.Customer
@* Khai báo Model kiểu Customer *@
@{
    Layout = "_LayoutAdmin"; @* Áp dụng layout quản trị Admin *@
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --th-bg: #FAF8F5;
        --th-primary: #8B5E3C;
        --th-secondary: #D9C3B0;
        --th-border: #EEE7E1;
        --th-text-main: #2C2C2C;
        --th-text-sub: #8A817C;
        --th-danger: #F44336;
        --th-warning: #FFB300;
        --th-success: #4CAF50;
    }

    .admin-wrapper {
        font-family: 'Inter', sans-serif;
        background-color: var(--th-bg);
        padding: 32px;
        min-height: 100vh;
    }

    .page-title {
        font-size: 32px;
        font-weight: 700;
        color: var(--th-text-main);
        margin-bottom: 24px;
    }

    .th-card {
        background-color: #FFFFFF;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.04);
        border: 1px solid var(--th-border);
        padding: 32px;
    }

    .th-form-label {
        font-size: 14px;
        font-weight: 600;
        color: var(--th-text-main);
        margin-bottom: 8px;
    }

    .th-form-control {
        border-radius: 12px;
        border: 1px solid var(--th-border);
        padding: 12px 16px;
        font-size: 14px;
        color: var(--th-text-main);
        background-color: #FAF8F5;
        transition: all 0.2s ease;
        width: 100%;
        box-shadow: none !important;
    }

    .th-form-control:focus {
        border-color: var(--th-primary);
        background-color: #FFFFFF;
        outline: none;
    }
    
    .th-form-control::placeholder {
        color: #BDB5AF;
    }

    .th-btn {
        height: 48px;
        border-radius: 12px;
        padding: 0 24px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
        text-decoration: none;
    }

    .th-btn-primary {
        background-color: var(--th-primary);
        color: white;
    }

    .th-btn-primary:hover {
        background-color: #724c30;
        color: white;
    }

    .th-btn-outline {
        background-color: transparent;
        border: 1px solid #BDB5AF;
        color: var(--th-text-sub);
    }

    .th-btn-outline:hover {
        border-color: var(--th-text-main);
        color: var(--th-text-main);
    }
</style>

<div class="admin-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title">Thêm Khách Hàng Mới</h1>
        <div class="d-flex gap-3">
            <a asp-action="Index" class="th-btn th-btn-outline">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </div>
    
    <div class="th-card">
        <form asp-action="Create" method="post">
            <div class="row gx-5">
                <div class="col-md-6">
                    <div class="mb-4">
                        <label class="th-form-label">Họ và tên khách hàng</label>
                        <input asp-for="FullName" class="th-form-control" placeholder="Nhập họ và tên..." required />
                        <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label class="th-form-label">Địa chỉ Email</label>
                        <input asp-for="Email" class="th-form-control" type="email" placeholder="Nhập email..." required />
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label class="th-form-label">Mật khẩu tài khoản</label>
                        <input asp-for="Password" class="th-form-control" type="password" placeholder="Nhập mật khẩu..." required />
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-4">
                        <label class="th-form-label">Số điện thoại</label>
                        <input asp-for="Phone" class="th-form-control" placeholder="Nhập số điện thoại..." />
                        <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label class="th-form-label">Địa chỉ giao hàng</label>
                        <textarea asp-for="Address" class="th-form-control" rows="4" placeholder="Nhập địa chỉ đầy đủ của khách hàng..."></textarea>
                        <span asp-validation-for="Address" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top" style="border-color: var(--th-border) !important;">
                <button type="submit" class="th-btn th-btn-primary px-5">
                    <i class="bi bi-plus-lg"></i> Lưu thông tin
                </button>
            </div>
        </form>
    </div>
</div>
