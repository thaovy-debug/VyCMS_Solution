@model CMS.Data.Entities.Customer
@* Khai báo Model kiểu Customer *@
@{
    Layout = "_LayoutAdmin"; @* Áp dụng layout quản trị Admin *@
}

<div class="container mt-4 mb-5"> @* Vùng chứa chính *@
    <h2 class="text-primary">THÊM KHÁCH HÀNG MỚI</h2> @* Tiêu đề *@
    <hr /> @* Kẻ ngang *@

    <form asp-action="Create" method="post"> @* Form gửi POST *@
        <div class="row"> @* Chia hai cột *@
            <div class="col-md-6"> @* Cột bên trái *@
                <div class="mb-3"> @* Họ tên *@
                    <label class="form-label fw-bold">Họ và tên khách hàng:</label>
                    <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên..." required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3"> @* Email *@
                    <label class="form-label fw-bold">Địa chỉ Email:</label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="Nhập email..." required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3"> @* Mật khẩu *@
                    <label class="form-label fw-bold">Mật khẩu tài khoản:</label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="Nhập mật khẩu..." required />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
            </div>

            <div class="col-md-6"> @* Cột bên phải *@
                <div class="mb-3"> @* Điện thoại *@
                    <label class="form-label fw-bold">Số điện thoại:</label>
                    <input asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại..." />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <div class="mb-3"> @* Địa chỉ *@
                    <label class="form-label fw-bold">Địa chỉ giao hàng:</label>
                    <textarea asp-for="Address" class="form-control" rows="4" placeholder="Nhập địa chỉ đầy đủ của khách hàng..."></textarea>
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="mt-3"> @* Nút lưu *@
            <button type="submit" class="btn btn-success">Lưu thông tin</button>
            <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
        </div>
    </form>
</div>
