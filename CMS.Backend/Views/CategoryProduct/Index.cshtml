@*
Sinh vien:Nguyễn Quỳnh Thảo Vy
Ma sv: 2123110158
Lop:CCQ2311E
Mo ta: Giao diện hiển thị danh sách các danh mục loại sản phẩm (Đã áp dụng Layout Admin quản trị), 
Ngay thuc hien: 15/05/2026
*@
@model IEnumerable<CMS.Data.Entities.CategoryProduct>
@* Khai báo Model nhận danh sách thực thể CategoryProduct *@
@{
    Layout = "_LayoutAdmin"; @* Áp dụng layout quản trị Admin *@
}

<div class="py-4"> @* Vùng đệm dọc cho trang *@
    <div class="d-flex justify-content-between align-items-center mb-3"> @* Bố cục căn ngang *@
        <h2 class="text-primary">QUẢN LÝ LOẠI SẢN PHẨM</h2> @* Tiêu đề chính *@
        <a asp-action="Create" class="btn btn-success"> @* Nút thêm mới *@
            <i class="bi bi-plus-circle"></i> Thêm loại sản phẩm mới
        </a> @* Kết thúc nút thêm *@
    </div> @* Kết thúc tiêu đề *@

    <table class="table table-striped table-bordered"> @* Bảng kẻ sọc và viền ngoài *@
        <thead class="table-light"> @* Phần đầu bảng *@
            <tr> @* Dòng tiêu đề *@
                <th style="width:80px">ID</th> @* Cột ID *@
                <th>Hình ảnh</th> @* Cột ảnh *@
                <th>Tên loại sản phẩm</th> @* Cột tên loại *@
                <th>Mô tả chi tiết</th> @* Cột mô tả *@
                <th style="width:180px">Thao tác</th> @* Cột thao tác *@
            </tr> @* Đóng dòng *@
        </thead> @* Đóng đầu *@
        <tbody> @* Phần thân *@
            @foreach (var item in Model) @* Duyệt qua danh sách *@
            {
                <tr> @* Dòng dữ liệu *@
                    <td>@item.Id</td> @* Hiển thị mã Id *@
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" style="width: 50px; height: 50px; object-fit: cover;" class="rounded-circle" />
                        }
                    </td>
                    <td>@item.Name</td> @* Hiển thị tên *@
                    <td>@item.Description</td> @* Hiển thị mô tả *@
                    <td> @* Các nút thao tác *@
                        @* Nút sửa *@
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Sửa</a>
                        
                        @* Nút xóa *@
                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger"
                           onclick="return confirm('Bạn có chắc chắn muốn xóa loại sản phẩm này không?')">Xóa</a>
                    </td> @* Đóng ô thao tác *@
                </tr> @* Đóng dòng *@
            } @* Đóng vòng lặp *@
        </tbody> @* Đóng thân *@
    </table> @* Đóng bảng *@
</div> @* Đóng py-4 *@
