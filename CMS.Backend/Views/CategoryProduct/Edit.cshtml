@*
Sinh vien:Nguyễn Quỳnh Thảo Vy
Ma sv: 2123110158
Lop:CCQ2311E
Mo ta: Giao diện chỉnh sửa thông tin loại sản phẩm (Đã áp dụng Layout Admin quản trị), 
Ngay thuc hien: 15/05/2026
*@
@model CMS.Data.Entities.CategoryProduct
@* Khai báo Model kiểu CategoryProduct *@
@{
    Layout = "_LayoutAdmin"; @* Áp dụng layout quản trị Admin *@
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --th-bg: #FAF8F5;
        --th-primary: #8B5E3C;
        --th-secondary: #D9C3B0;
        --th-border: #EEE7E1;
        --th-text-main: #2C2C2C;
        --th-text-sub: #8A817C;
        --th-danger: #F44336;
        --th-warning: #FFB300;
        --th-success: #4CAF50;
    }

    .admin-wrapper {
        font-family: 'Inter', sans-serif;
        background-color: var(--th-bg);
        padding: 32px;
        min-height: 100vh;
    }

    .page-title {
        font-size: 32px;
        font-weight: 700;
        color: var(--th-text-main);
        margin-bottom: 24px;
    }

    .th-card {
        background-color: #FFFFFF;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.04);
        border: 1px solid var(--th-border);
        padding: 32px;
        max-width: 800px;
    }

    .th-form-label {
        font-size: 14px;
        font-weight: 600;
        color: var(--th-text-main);
        margin-bottom: 8px;
    }

    .th-form-control {
        border-radius: 12px;
        border: 1px solid var(--th-border);
        padding: 12px 16px;
        font-size: 14px;
        color: var(--th-text-main);
        background-color: #FAF8F5;
        transition: all 0.2s ease;
        width: 100%;
        box-shadow: none !important;
    }

    .th-form-control:focus {
        border-color: var(--th-primary);
        background-color: #FFFFFF;
        outline: none;
    }
    
    .th-form-control::placeholder {
        color: #BDB5AF;
    }

    .th-btn {
        height: 48px;
        border-radius: 12px;
        padding: 0 24px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
        text-decoration: none;
    }

    .th-btn-warning {
        background-color: var(--th-warning);
        color: #FFFFFF;
    }

    .th-btn-warning:hover {
        background-color: #E6A100;
        color: #FFFFFF;
    }

    .th-btn-outline {
        background-color: transparent;
        border: 1px solid #BDB5AF;
        color: var(--th-text-sub);
    }

    .th-btn-outline:hover {
        border-color: var(--th-text-main);
        color: var(--th-text-main);
    }
</style>

<div class="admin-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title">Chỉnh Sửa Danh Mục Sản Phẩm</h1>
        <div class="d-flex gap-3">
            <a asp-action="Index" class="th-btn th-btn-outline">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </div>
    
    <div class="th-card">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />

            <div class="mb-4">
                <label class="th-form-label">Tên danh mục sản phẩm</label>
                <input asp-for="Name" class="th-form-control" required />
                <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4">
                <label class="th-form-label">Hình ảnh đại diện hiện tại</label>
                <div class="d-flex align-items-end gap-3 mb-3">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="Current Image" style="width: 100px; height: 100px; object-fit: cover; border-radius: 12px; border: 1px solid var(--th-border);" />
                    }
                    else
                    {
                        <div style="width: 100px; height: 100px; border-radius: 12px; border: 1px dashed var(--th-border); background-color: var(--th-bg);" class="d-flex align-items-center justify-content-center text-muted small">Chưa có ảnh</div>
                    }
                    <div class="flex-grow-1">
                        <input type="file" name="uploadImage" class="th-form-control" accept="image/*" style="background-color: #FFFFFF;" />
                        <small class="text-muted mt-2 d-block">Chọn ảnh mới nếu muốn thay đổi ảnh hiện tại.</small>
                    </div>
                </div>
                <input type="hidden" asp-for="ImageUrl" />
            </div>

            <div class="mb-4">
                <label class="th-form-label">Mô tả chi tiết</label>
                <textarea asp-for="Description" class="th-form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mt-4 pt-3 border-top" style="border-color: var(--th-border) !important;">
                <button type="submit" class="th-btn th-btn-warning px-5">
                    <i class="bi bi-check-lg"></i> Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</div>
