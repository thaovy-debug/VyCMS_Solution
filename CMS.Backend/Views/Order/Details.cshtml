@*
Sinh vien:Nguyễn Quỳnh Thảo Vy
Ma sv: 2123110158
Lop:CCQ2311E
Mo ta: Giao diện hiển thị chi tiết thông tin đơn hàng, danh sách các sản phẩm và tổng tiền thanh toán (Đã áp dụng Layout Admin), 
Ngay thuc hien: 15/05/2026
*@
@model CMS.Data.Entities.Order
@* Khai báo Model kiểu Order *@
@{
    Layout = "_LayoutAdmin"; @* Áp dụng layout quản trị Admin *@
    var totalAmount = 0m; @* Khởi tạo biến tổng tiền *@
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --th-bg: #FAF8F5;
        --th-primary: #8B5E3C;
        --th-secondary: #D9C3B0;
        --th-border: #EEE7E1;
        --th-text-main: #2C2C2C;
        --th-text-sub: #8A817C;
        --th-danger: #F44336;
        --th-warning: #FFB300;
        --th-success: #4CAF50;
    }

    .admin-wrapper {
        font-family: 'Inter', sans-serif;
        background-color: var(--th-bg);
        padding: 32px;
        min-height: 100vh;
    }

    .page-title {
        font-size: 32px;
        font-weight: 700;
        color: var(--th-text-main);
        margin-bottom: 24px;
    }

    /* Card styling */
    .th-card {
        background-color: #FFFFFF;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.04);
        border: 1px solid var(--th-border);
        margin-bottom: 24px;
        overflow: hidden;
    }
    
    .th-card-header {
        padding: 20px 24px;
        background-color: #FDFBFA;
        border-bottom: 1px solid var(--th-border);
        font-size: 16px;
        font-weight: 700;
        color: var(--th-text-main);
    }
    
    .th-card-body {
        padding: 24px;
    }
    
    .info-label {
        font-size: 13px;
        color: var(--th-text-sub);
        font-weight: 600;
        margin-bottom: 4px;
    }
    
    .info-value {
        font-size: 15px;
        color: var(--th-text-main);
        font-weight: 500;
        margin-bottom: 16px;
    }

    .th-btn {
        height: 48px;
        border-radius: 12px;
        padding: 0 24px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
        text-decoration: none;
    }

    .th-btn-outline {
        background-color: transparent;
        border: 1px solid #BDB5AF;
        color: var(--th-text-sub);
    }

    .th-btn-outline:hover {
        border-color: var(--th-text-main);
        color: var(--th-text-main);
    }

    /* Table */
    .th-table-container {
        overflow-x: auto;
    }

    .th-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .th-table th {
        font-size: 14px;
        font-weight: 600;
        color: var(--th-text-sub);
        padding: 16px 12px;
        border-bottom: 1px solid var(--th-border);
        white-space: nowrap;
        text-align: left;
    }

    .th-table td {
        padding: 16px 12px;
        font-size: 14px;
        color: var(--th-text-main);
        border-bottom: 1px solid var(--th-border);
        vertical-align: middle;
        background: #FFFFFF;
    }

    .th-table tr {
        transition: background-color 0.2s ease;
    }

    .th-table tbody tr:hover td {
        background-color: #FDFBFA;
    }
    
    .th-table tfoot td {
        background-color: #FDFBFA;
        border-bottom: none;
        padding: 20px 12px;
    }
    
    .status-badge {
        padding: 6px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        display: inline-block;
    }
</style>

<div class="admin-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title mb-0">Chi tiết Đơn hàng #@Model.Id</h1>
        <div class="d-flex gap-3">
            @if (Model.Status == 7)
            {
                <button class="th-btn" style="background-color: var(--th-danger); color: white;" data-bs-toggle="modal" data-bs-target="#acceptCancelModal">
                    <i class="bi bi-check-circle"></i> Chấp nhận hủy đơn
                </button>
            }
            @if (Model.Status == 6)
            {
                <button type="button" class="th-btn" style="background-color: var(--th-success); color: white;" onclick="finishOrderUpdate()">
                    <i class="bi bi-check2-all"></i> Hoàn tất cập nhật đơn
                </button>
            }
            <a asp-action="Index" class="th-btn th-btn-outline">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="th-card h-100 mb-0">
                <div class="th-card-header">
                    Thông Tin Khách Hàng
                </div>
                <div class="th-card-body">
                    @{
                        string displayAddress = Model.Customer?.Address ?? "";
                        string displayPhone = Model.Customer?.Phone ?? "";
                        string displayNotes = Model.Notes ?? "";

                        if (!string.IsNullOrEmpty(Model.Notes) && Model.Notes.StartsWith("Giao đến: "))
                        {
                            var parts = Model.Notes.Split(new[] { " | ĐT: ", " | Ghi chú: " }, StringSplitOptions.None);
                            if (parts.Length > 0) displayAddress = parts[0].Replace("Giao đến: ", "");
                            if (parts.Length > 1) displayPhone = parts[1];
                            if (parts.Length > 2) displayNotes = parts[2];
                            else displayNotes = "Không có ghi chú";
                        }
                    }
                    
                    <div class="info-label">Họ và tên</div>
                    <div class="info-value">@Model.Customer?.FullName</div>
                    
                    <div class="info-label">Email</div>
                    <div class="info-value">@Model.Customer?.Email</div>
                    
                    <div class="info-label">Số điện thoại</div>
                    <div class="info-value">@displayPhone</div>
                    
                    <div class="info-label">Địa chỉ giao hàng</div>
                    <div class="info-value mb-0">@displayAddress</div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="th-card h-100 mb-0">
                <div class="th-card-header">
                    Thông Tin Đơn Hàng
                </div>
                <div class="th-card-body">
                    <div class="info-label">Ngày đặt hàng</div>
                    <div class="info-value">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                    
                    <div class="info-label">Trạng thái</div>
                    <div class="info-value">
                        @if (Model.Status == 0)
                        {
                            <span class="status-badge" style="background-color: #F2F0ED; color: #8A817C;">Chờ xác nhận</span>
                        }
                        else if (Model.Status == 1)
                        {
                            <span class="status-badge" style="background-color: #FFF8E1; color: #FFB300;">Chờ giao hàng</span>
                        }
                        else if (Model.Status == 2)
                        {
                            <span class="status-badge" style="background-color: #F8F3ED; color: var(--th-primary);">Đang giao hàng</span>
                        }
                        else if (Model.Status == 3)
                        {
                            <span class="status-badge" style="background-color: #E8F5E9; color: var(--th-success);">Đã giao</span>
                        }
                        else if (Model.Status == 4)
                        {
                            <span class="status-badge" style="background-color: #FEECEB; color: var(--th-danger);">Đã hủy</span>
                        }
                        else if (Model.Status == 5)
                        {
                            <span class="status-badge" style="background-color: #FFF3E0; color: #FF9800;">Chờ khách xác nhận</span>
                        }
                        else if (Model.Status == 6)
                        {
                            <span class="status-badge" style="background-color: #E8F5E9; color: var(--th-success);">Khách đồng ý sửa đơn</span>
                        }
                        else if (Model.Status == 7)
                        {
                            <span class="status-badge" style="background-color: #FEECEB; color: var(--th-danger);">Khách yêu cầu hủy đơn</span>
                        }
                    </div>
                    
                    <div class="info-label">Ghi chú đơn hàng</div>
                    <div class="info-value mb-0">@(string.IsNullOrEmpty(displayNotes) ? "Không có ghi chú" : displayNotes)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="th-card">
        <div class="th-card-header d-flex justify-content-between align-items-center" style="background-color: #FDFBFA; border-bottom: 1px solid var(--th-border);">
            <span>Danh Sách Sản Phẩm Đã Đặt</span>
            <button class="th-btn" style="background-color: var(--th-primary); color: white; height: 36px; padding: 0 16px;" data-bs-toggle="modal" data-bs-target="#sendMessageModal">
                <i class="bi bi-chat-dots"></i> Gửi thông báo cho khách
            </button>
        </div>
        <div class="th-table-container">
            <table class="th-table">
                <thead>
                    <tr>
                        <th style="width:60px; text-align:center;">STT</th>
                        <th style="width:100px; text-align:center;">Ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th style="width:180px; text-align:right;">Đơn giá</th>
                        <th style="width:100px; text-align:center;">Số lượng</th>
                        <th style="width:200px; text-align:right;">Thành tiền</th>
                        @if (Model.Status == 6)
                        {
                            <th style="width:100px; text-align:center;">Thao tác</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                    {
                        int index = 1;
                        foreach (var detail in Model.OrderDetails)
                        {
                            var subtotal = detail.UnitPrice * detail.Quantity;
                            totalAmount += subtotal;

                            <tr>
                                <td class="text-center text-muted fw-semibold">@index</td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(detail.Product?.ImageUrl))
                                    {
                                        <img src="@detail.Product.ImageUrl" alt="@detail.Product.Name" style="width: 72px; height: 72px; object-fit: cover; border-radius: 12px; border: 1px solid var(--th-border);" />
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold" style="color: var(--th-text-main); font-size: 15px;">@detail.Product?.Name</div>
                                    @if (!string.IsNullOrEmpty(detail.Color) || !string.IsNullOrEmpty(detail.Size))
                                    {
                                        <div class="mt-2 d-flex gap-2">
                                            @if (!string.IsNullOrEmpty(detail.Color))
                                            {
                                                <span style="background-color: #F8F3ED; color: var(--th-primary); padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 600;">Màu: @detail.Color</span>
                                            }
                                            @if (!string.IsNullOrEmpty(detail.Size))
                                            {
                                                <span style="background-color: #F8F3ED; color: var(--th-primary); padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 600;">Size: @detail.Size</span>
                                            }
                                        </div>
                                    }
                                    <div class="text-muted small mt-2">ID sản phẩm: @detail.ProductId</div>
                                </td>
                                <td class="text-end fw-semibold text-muted">@detail.UnitPrice.ToString("N0") VNĐ</td>
                                <td class="text-center fw-bold">@detail.Quantity</td>
                                <td class="text-end fw-bold text-danger" style="font-size: 15px;">@subtotal.ToString("N0") VNĐ</td>
                                @if (Model.Status == 6)
                                {
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-primary" style="margin-right:4px;" onclick="openEditModal(@Model.Id, @detail.Id, @detail.Quantity)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form asp-action="DeleteDetail" method="post" class="d-inline">
                                            <input type="hidden" name="orderId" value="@Model.Id" />
                                            <input type="hidden" name="detailId" value="@detail.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này khỏi đơn hàng?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                }
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted p-5">
                                <i class="bi bi-box-seam" style="font-size: 32px; opacity: 0.5;"></i>
                                <div class="mt-2">Đơn hàng chưa có chi tiết sản phẩm.</div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="@(Model.Status == 6 ? 5 : 5)" class="text-end fw-bold" style="font-size: 16px; color: var(--th-text-main); white-space: nowrap;">TỔNG CỘNG:</td>
                        <td class="text-end fw-bold text-danger" style="font-size: 20px; white-space: nowrap;">@totalAmount.ToString("N0") VNĐ</td>
                        @if (Model.Status == 6)
                        {
                            <td></td>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>


<!-- Modal Send Message -->
<div class="modal fade" id="sendMessageModal" tabindex="-1" aria-labelledby="sendMessageModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="SendMessage" method="post">
            <input type="hidden" name="orderId" value="@Model.Id" />
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="sendMessageModalLabel">Gửi thông báo cho khách hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="message" class="form-label">Nội dung thông báo (VD: Xin lỗi, sản phẩm bị lỗi kho không đủ hàng. Bạn có muốn giảm số lượng hay hủy đơn?)</label>
                        <textarea class="form-control" id="message" name="message" rows="4" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary" style="background-color: var(--th-primary); border-color: var(--th-primary);">Gửi thông báo</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Modal Edit Detail -->
<div class="modal fade" id="editDetailModal" tabindex="-1" aria-labelledby="editDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <form asp-action="EditDetail" method="post">
            <input type="hidden" name="orderId" value="@Model.Id" />
            <input type="hidden" name="detailId" id="editDetailId" value="" />
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editDetailModalLabel">Cập nhật số lượng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="newQuantity" class="form-label">Số lượng mới</label>
                        <input type="number" class="form-control" id="newQuantity" name="newQuantity" min="1" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    function finishOrderUpdate() {
        if (!confirm('Xác nhận hoàn tất cập nhật đơn hàng? Đơn hàng sẽ chuyển về trạng thái "Chờ giao hàng".')) return;
        $.ajax({
            url: '/Order/UpdateStatus',
            type: 'POST',
            data: { id: @Model.Id, status: 1 },
            success: function(res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert("Lỗi: " + res.message);
                }
            },
            error: function() {
                alert("Có lỗi xảy ra!");
            }
        });
    }

    function openEditModal(orderId, detailId, currentQuantity) {
        document.getElementById('editDetailId').value = detailId;
        document.getElementById('newQuantity').value = currentQuantity;
        var editModal = new bootstrap.Modal(document.getElementById('editDetailModal'));
        editModal.show();
    }
</script>

<!-- Modal Accept Cancel -->
<div class="modal fade" id="acceptCancelModal" tabindex="-1" aria-labelledby="acceptCancelModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="AcceptCancel" method="post">
            <input type="hidden" name="orderId" value="@Model.Id" />
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger" id="acceptCancelModalLabel">Chấp nhận yêu cầu hủy đơn</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="cancelReason" class="form-label">Lý do/Tin nhắn (Sẽ gửi qua email cho khách)</label>
                        <textarea class="form-control" id="cancelReason" name="cancelReason" rows="4" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger">Xác nhận hủy đơn & Gửi Email</button>
                </div>
            </div>
        </form>
    </div>
</div>
