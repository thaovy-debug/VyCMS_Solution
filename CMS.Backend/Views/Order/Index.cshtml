@*
Sinh vien:Nguyễn Quỳnh Thảo Vy
Ma sv: 2123110158
Lop:CCQ2311E
Mo ta: Giao diện quản lý danh sách đơn đặt hàng từ khách hàng, tính toán tổng tiền, hiển thị trạng thái bằng badge màu (Đã áp dụng Layout Admin), 
Ngay thuc hien: 15/05/2026
*@
@model IEnumerable<CMS.Data.Entities.Order>
@* Khai báo Model nhận danh sách thực thể Order *@
@{
    Layout = "_LayoutAdmin"; @* Áp dụng layout quản trị Admin *@
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --th-bg: #FAF8F5;
        --th-primary: #8B5E3C;
        --th-secondary: #D9C3B0;
        --th-border: #EEE7E1;
        --th-text-main: #2C2C2C;
        --th-text-sub: #8A817C;
        --th-danger: #F44336;
        --th-warning: #FFB300;
        --th-success: #4CAF50;
    }

    .admin-wrapper {
        font-family: 'Inter', sans-serif;
        background-color: var(--th-bg);
        padding: 32px;
        min-height: 100vh;
    }

    .page-title {
        font-size: 42px;
        font-weight: 700;
        color: var(--th-text-main);
        margin-bottom: 0;
    }

    /* Card styling */
    .th-card {
        background-color: #FFFFFF;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.04);
        border: 1px solid var(--th-border);
        margin-bottom: 24px;
        overflow: hidden;
    }

    .th-btn {
        height: 48px;
        border-radius: 12px;
        padding: 0 24px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
        text-decoration: none;
    }

    .th-btn-primary {
        background-color: var(--th-primary);
        color: white;
    }

    .th-btn-primary:hover {
        background-color: #724c30;
        color: white;
    }

    /* Table */
    .th-table-container {
        overflow-x: auto;
    }

    .th-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .th-table th {
        font-size: 14px;
        font-weight: 600;
        color: var(--th-text-sub);
        padding: 16px 12px;
        border-bottom: 1px solid var(--th-border);
        white-space: nowrap;
        text-align: left;
    }

    .th-table td {
        padding: 12px;
        font-size: 13px;
        color: var(--th-text-main);
        border-bottom: 1px solid var(--th-border);
        vertical-align: middle;
        background: #FFFFFF;
    }

    .th-table tr {
        height: 96px;
        transition: background-color 0.2s ease;
    }

    .th-table tbody tr:hover td {
        background-color: #FDFBFA;
    }

    /* Actions */
    .th-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: stretch;
    }

    .th-btn-action {
        height: 32px;
        padding: 0 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        transition: all 0.2s ease;
        text-decoration: none;
        width: 100%;
    }

    .th-btn-detail {
        border: 1px solid #BDB5AF;
        color: var(--th-text-sub);
    }
    .th-btn-detail:hover { background: var(--th-text-main); color: white; border-color: var(--th-text-main); }
    
    .status-dropdown {
        border-radius: 12px;
        padding: 8px 12px;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s ease;
    }
    .status-dropdown:focus {
        box-shadow: 0 0 0 4px rgba(139, 94, 60, 0.1);
    }
</style>

<div class="admin-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title">Quản lý Đơn Hàng</h1>
    </div>

    <div class="th-card th-table-container">
        <table class="th-table">
            <thead>
                <tr>
                    <th style="width:60px">ID</th>
                    <th style="width:80px; text-align:center;">Ảnh</th>
                    <th style="width:180px">Sản phẩm</th>
                    <th style="width:160px">Khách hàng</th>
                    <th style="width:140px">Ngày đặt</th>
                    <th style="width:140px">Tổng tiền</th>
                    <th style="width:200px">Trạng thái</th>
                    <th>Ghi chú</th>
                    <th style="width:100px; text-align:center;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var total = 0m;
                    if (item.OrderDetails != null)
                    {
                        total = item.OrderDetails.Sum(od => od.UnitPrice * od.Quantity);
                    }

                    <tr>
                        <td class="fw-semibold text-muted">#@item.Id</td>
                        <td class="text-center">
                            @if (item.OrderDetails != null && item.OrderDetails.Any())
                            {
                                var firstProduct = item.OrderDetails.FirstOrDefault()?.Product;
                                if (firstProduct != null && !string.IsNullOrEmpty(firstProduct.ImageUrl))
                                {
                                    <img src="@firstProduct.ImageUrl" alt="Product" style="width: 56px; height: 56px; object-fit: cover; border-radius: 12px; border: 1px solid var(--th-border);" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center mx-auto" style="width: 56px; height: 56px; border-radius: 12px; border: 1px dashed var(--th-border); background-color: var(--th-bg);">
                                        <i class="bi bi-image text-muted" style="font-size: 20px;"></i>
                                    </div>
                                }
                            }
                        </td>
                        <td>
                            @if (item.OrderDetails != null && item.OrderDetails.Any())
                            {
                                var firstProduct = item.OrderDetails.FirstOrDefault()?.Product;
                                <div class="fw-bold" style="color: var(--th-text-main); font-size: 14px; max-width: 160px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@firstProduct?.Name">
                                    @(firstProduct?.Name ?? "Sản phẩm")
                                </div>
                                @if (item.OrderDetails.Count > 1)
                                {
                                    <span class="d-inline-block mt-2 px-2 py-1" style="background-color: #F8F3ED; color: var(--th-primary); font-size: 11px; font-weight: 600; border-radius: 6px;">
                                        +@(item.OrderDetails.Count - 1) sp khác
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">0 sp</span>
                            }
                        </td>
                        <td class="fw-bold" style="color: var(--th-text-main);">@item.Customer?.FullName</td>
                        <td class="text-muted" style="font-size: 13px;">@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="fw-bold text-danger">@total.ToString("N0") VNĐ</td>
                        <td>
                            @if (item.Status == 4 || item.Status == 7)
                            {
                                <span class="badge fw-bold text-white px-3 py-2" style="background-color: #F44336; border-radius: 12px; font-size: 13px;">Đã hủy</span>
                            }
                            else if (item.Status == 6)
                            {
                                <select class="form-select status-dropdown fw-bold text-white border-0" data-id="@item.Id" style="background-color: #2196F3; cursor: pointer;">
                                    <option value="6" selected style="background:white;color:black">Khách đồng ý sửa đơn</option>
                                    <option value="0" style="background:white;color:black">Chờ xác nhận</option>
                                    <option value="1" style="background:white;color:black">Chờ giao hàng</option>
                                    <option value="2" style="background:white;color:black">Đang giao hàng</option>
                                    <option value="3" style="background:white;color:black">Đã giao</option>
                                </select>
                            }
                            else
                            {
                                <select class="form-select status-dropdown fw-bold text-white border-0" data-id="@item.Id" style="background-color: @(item.Status == 0 ? "#8A817C" : item.Status == 1 ? "#FFB300" : item.Status == 2 ? "#8B5E3C" : "#4CAF50"); cursor: pointer;">
                                    @if (item.Status == 0) { <option value="0" selected style="background:white;color:black">Chờ xác nhận</option> } else { <option value="0" style="background:white;color:black">Chờ xác nhận</option> }
                                    @if (item.Status == 1) { <option value="1" selected style="background:white;color:black">Chờ giao hàng</option> } else { <option value="1" style="background:white;color:black">Chờ giao hàng</option> }
                                    @if (item.Status == 2) { <option value="2" selected style="background:white;color:black">Đang giao hàng</option> } else { <option value="2" style="background:white;color:black">Đang giao hàng</option> }
                                    @if (item.Status == 3) { <option value="3" selected style="background:white;color:black">Đã giao</option> } else { <option value="3" style="background:white;color:black">Đã giao</option> }
                                </select>
                            }
                        </td>
                        <td class="text-muted" style="font-size: 13px;">
                            @if (!string.IsNullOrEmpty(item.Notes))
                            {
                                <div style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@item.Notes">
                                    @item.Notes
                                </div>
                            }
                        </td>
                        <td>
                            <div class="th-actions justify-content-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="th-btn-action th-btn-detail w-100">Chi tiết</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.status-dropdown').change(function () {
                var $select = $(this);
                var orderId = $select.data('id');
                var newStatus = $select.val();
                
                // Thay đổi màu nền ngay lập tức để phản hồi nhanh
                if (newStatus == '0') $select.css('background-color', '#6c757d');
                else if (newStatus == '1') $select.css('background-color', '#ffc107');
                else if (newStatus == '2') $select.css('background-color', '#0d6efd');
                else if (newStatus == '3') $select.css('background-color', '#198754');

                $.ajax({
                    url: '/Order/UpdateStatus',
                    type: 'POST',
                    data: {
                        id: orderId,
                        status: newStatus
                    },
                    success: function (res) {
                        if (res.success) {
                            // Thành công
                        } else {
                            alert("Lỗi: " + res.message);
                        }
                    },
                    error: function () {
                        alert("Có lỗi xảy ra khi cập nhật trạng thái!");
                    }
                });
            });
        });
    </script>
}
