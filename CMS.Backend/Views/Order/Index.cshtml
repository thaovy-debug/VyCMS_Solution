@*
Sinh vien:Nguyễn Quỳnh Thảo Vy
Ma sv: 2123110158
Lop:CCQ2311E
Mo ta: Giao diện quản lý danh sách đơn đặt hàng từ khách hàng, tính toán tổng tiền, hiển thị trạng thái bằng badge màu (Đã áp dụng Layout Admin), 
Ngay thuc hien: 15/05/2026
*@
@model IEnumerable<CMS.Data.Entities.Order>
@* Khai báo Model nhận danh sách thực thể Order *@
@{
    Layout = "_LayoutAdmin"; @* Áp dụng layout quản trị Admin *@
}

<div class="py-4"> @* Vùng đệm dọc cho trang *@
    <div class="d-flex justify-content-between align-items-center mb-3"> @* Bố cục căn ngang hai đầu *@
        <h2 class="text-primary">QUẢN LÝ ĐƠN HÀNG</h2> @* Tiêu đề quản lý *@
    </div> @* Kết thúc tiêu đề *@

    <table class="table table-striped table-bordered align-middle"> @* Bảng dữ liệu *@
        <thead class="table-light"> @* Phần đầu bảng *@
            <tr> @* Dòng tiêu đề *@
                <th style="width:70px">ID</th> @* Cột ID *@
                <th>Khách hàng</th> @* Cột tên khách hàng *@
                <th style="width:150px">Ngày đặt hàng</th> @* Cột ngày đặt *@
                <th style="width:150px">Tổng tiền (VNĐ)</th> @* Cột tổng tiền đơn hàng *@
                <th style="width:150px">Trạng thái</th> @* Cột trạng thái đơn hàng *@
                <th>Ghi chú đơn hàng</th> @* Cột ghi chú khách hàng *@
                <th style="width:220px">Thao tác</th> @* Cột thao tác *@
            </tr> @* Đóng dòng *@
        </thead> @* Đóng đầu *@
        <tbody> @* Phần thân *@
            @foreach (var item in Model) @* Duyệt danh sách *@
            {
                var total = 0m; @* Khởi tạo biến tổng tiền đơn hàng *@
                if (item.OrderDetails != null) @* Nếu có danh sách chi tiết đơn hàng *@
                {
                    total = item.OrderDetails.Sum(od => od.UnitPrice * od.Quantity); // Tính tổng tiền
                }

                <tr> @* Dòng chứa thông tin đơn hàng *@
                    <td>@item.Id</td> @* Ô hiển thị mã Id *@
                    <td class="fw-bold">@item.Customer?.FullName</td> @* Ô hiển thị tên khách hàng *@
                    <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td> @* Ô hiển thị ngày giờ đặt *@
                    <td class="text-end fw-semibold text-danger">@total.ToString("N0") đ</td> @* Định dạng tiền tệ VNĐ *@
                    <td class="text-center"> @* Ô hiển thị trạng thái đơn hàng dạng badge *@
                        @if (item.Status == 0) // Chờ duyệt
                        {
                            <span class="badge bg-warning text-dark px-3 py-1">Chờ duyệt</span>
                        }
                        else if (item.Status == 1) // Đang giao
                        {
                            <span class="badge bg-primary px-3 py-1">Đang giao</span>
                        }
                        else if (item.Status == 2) // Đã xong
                        {
                            <span class="badge bg-success px-3 py-1">Đã xong</span>
                        }
                    </td>
                    <td>@item.Notes</td> @* Ô hiển thị ghi chú đơn hàng *@
                    <td> @* Ô thao tác gồm xem chi tiết, sửa và xóa *@
                        @* Nút xem chi tiết *@
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                        
                        @* Nút sửa trạng thái *@
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Cập nhật</a>
                        
                        @* Nút xóa *@
                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger"
                           onclick="return confirm('Bạn có chắc chắn muốn xóa đơn hàng này không? Việc này sẽ xóa toàn bộ chi tiết sản phẩm liên quan.')">Xóa</a>
                    </td> @* Đóng ô thao tác *@
                </tr> @* Đóng dòng *@
            } @* Đóng vòng lặp *@
        </tbody> @* Đóng thân *@
    </table> @* Đóng bảng *@
</div> @* Đóng khối py-4 *@
