@*
Sinh vien:Nguyễn Quỳnh Thảo Vy
Ma sv: 2123110158
Lop:CCQ2311E
Mo ta: Giao diện hiển thị danh sách các danh mục bài viết từ cơ sở dữ liệu (Đã áp dụng Layout Admin quản trị), 
Ngay thuc hien: 15/05/2026
*@
@model IEnumerable<CMS.Data.Entities.Category>
@* Khai báo Model nhận danh sách (tập hợp) các thực thể Category *@
@{
    Layout = "_LayoutAdmin"; @* Áp dụng layout quản trị Admin *@
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --th-bg: #FAF8F5;
        --th-primary: #8B5E3C;
        --th-secondary: #D9C3B0;
        --th-border: #EEE7E1;
        --th-text-main: #2C2C2C;
        --th-text-sub: #8A817C;
        --th-danger: #F44336;
        --th-warning: #FFB300;
    }

    .admin-wrapper {
        font-family: 'Inter', sans-serif;
        background-color: var(--th-bg);
        padding: 32px;
        min-height: 100vh;
    }

    .page-title {
        font-size: 42px;
        font-weight: 700;
        color: var(--th-text-main);
        margin-bottom: 0;
    }

    /* Card styling */
    .th-card {
        background-color: #FFFFFF;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.04);
        border: 1px solid var(--th-border);
        margin-bottom: 24px;
        overflow: hidden;
    }

    .th-btn {
        height: 48px;
        border-radius: 12px;
        padding: 0 24px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
        text-decoration: none;
    }

    .th-btn-primary {
        background-color: var(--th-primary);
        color: white;
    }

    .th-btn-primary:hover {
        background-color: #724c30;
        color: white;
    }

    /* Table */
    .th-table-container {
        overflow-x: auto;
    }

    .th-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .th-table th {
        font-size: 14px;
        font-weight: 600;
        color: var(--th-text-sub);
        padding: 16px 12px;
        border-bottom: 1px solid var(--th-border);
        white-space: nowrap;
        text-align: left;
    }

    .th-table td {
        padding: 12px;
        font-size: 13px;
        color: var(--th-text-main);
        border-bottom: 1px solid var(--th-border);
        vertical-align: middle;
        background: #FFFFFF;
    }

    .th-table tr {
        height: 96px;
        transition: background-color 0.2s ease;
    }

    .th-table tbody tr:hover td {
        background-color: #FDFBFA;
    }

    /* Actions */
    .th-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: stretch;
    }

    .th-btn-action {
        height: 32px;
        padding: 0 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        transition: all 0.2s ease;
        text-decoration: none;
        width: 100%;
    }

    .th-btn-edit {
        border: 1px solid var(--th-warning);
        color: var(--th-warning);
    }
    .th-btn-edit:hover { background: var(--th-warning); color: white; }

    .th-btn-delete {
        border: 1px solid var(--th-danger);
        color: var(--th-danger);
    }
    .th-btn-delete:hover { background: var(--th-danger); color: white; }
</style>

<div class="admin-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title">Danh sách Danh mục Bài viết</h1>
        <div class="d-flex gap-3">
            <a asp-action="Create" class="th-btn th-btn-primary">
                <i class="bi bi-plus-lg"></i> Thêm danh mục mới
            </a>
        </div>
    </div>

    <div class="th-card th-table-container">
        <table class="th-table">
            <thead>
                <tr>
                    <th style="width:80px">ID</th>
                    <th style="width:250px">Tên danh mục</th>
                    <th>Mô tả chi tiết</th>
                    <th style="width:100px; text-align:center;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold text-muted">#@item.Id</td>
                        <td class="fw-bold" style="color: var(--th-text-main); font-size: 15px;">@item.Name</td>
                        <td class="text-muted">
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <div style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 13px;" title="@item.Description">
                                    @item.Description
                                </div>
                            }
                        </td>
                        <td>
                            <div class="th-actions justify-content-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="th-btn-action th-btn-edit">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="th-btn-action th-btn-delete" onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục này?')">Xóa</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>