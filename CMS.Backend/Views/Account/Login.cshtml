@{
    Layout = null; // Trang đăng nhập độc lập hoàn toàn, không sử dụng Layout chung của hệ thống quản trị
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập quản trị - VyCMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

        :root {
            --th-bg: #FAF8F5;
            --th-primary: #8B5E3C;
            --th-secondary: #D9C3B0;
            --th-border: #EEE7E1;
            --th-text-main: #2C2C2C;
            --th-text-sub: #8A817C;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--th-bg);
            color: var(--th-text-main);
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        .login-card {
            background-color: #FFFFFF;
            border-radius: 24px;
            box-shadow: 0 16px 40px rgba(0,0,0,0.06);
            border: 1px solid var(--th-border);
            overflow: hidden;
            padding: 40px;
        }

        .login-title {
            font-size: 28px;
            font-weight: 700;
            color: var(--th-primary);
            margin-bottom: 8px;
            text-align: center;
        }

        .login-subtitle {
            font-size: 14px;
            color: var(--th-text-sub);
            text-align: center;
            margin-bottom: 32px;
        }

        .th-form-label {
            font-size: 14px;
            font-weight: 600;
            color: var(--th-text-main);
            margin-bottom: 8px;
        }

        .th-form-control {
            border-radius: 12px;
            border: 1px solid var(--th-border);
            padding: 14px 16px;
            font-size: 14px;
            color: var(--th-text-main);
            background-color: #FAF8F5;
            transition: all 0.2s ease;
            width: 100%;
            box-shadow: none !important;
            margin-bottom: 20px;
        }

        .th-form-control:focus {
            border-color: var(--th-primary);
            background-color: #FFFFFF;
            outline: none;
        }
        
        .th-form-control::placeholder {
            color: #BDB5AF;
        }

        .th-btn-primary {
            height: 52px;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 600;
            background-color: var(--th-primary);
            color: #FFFFFF;
            border: none;
            transition: all 0.2s ease;
            width: 100%;
            margin-top: 16px;
        }

        .th-btn-primary:hover {
            background-color: #724c30;
            color: #FFFFFF;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="login-card">
                    <div class="mb-4 text-center">
                        <h1 class="login-title">VyCMS</h1>
                        <p class="login-subtitle">Đăng nhập hệ thống quản trị</p>
                    </div>
                    
                    <form asp-action="Login" method="post">
                        <div>
                            <label class="th-form-label">Tên đăng nhập</label>
                            <input type="text" name="username" class="th-form-control" placeholder="Nhập tài khoản quản trị..." required />
                        </div>
                        
                        <div>
                            <label class="th-form-label">Mật khẩu</label>
                            <input type="password" name="password" class="th-form-control" placeholder="Nhập mật khẩu..." required />
                        </div>
                        
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger py-2 small" style="border-radius: 8px;">@ViewBag.Error</div>
                        }
                        
                        <button type="submit" class="th-btn-primary">ĐĂNG NHẬP</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
