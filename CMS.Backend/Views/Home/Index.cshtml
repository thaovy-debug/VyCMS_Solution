Mo ta: Giao diện trang chủ quản trị hiển thị tin tức mới nhất (Đã chuyển sang sử dụng Layout Admin có Sidebar), 
Ngay thuc hien: 15/05/2026
*@

@model IEnumerable<CMS.Data.Entities.Post>
@* Khai báo Model nhận danh sách các bài viết mới *@
@{
    Layout = "_LayoutAdmin"; @* Sử dụng Layout quản trị Admin có Sidebar thay vì menu ngang *@
    ViewData["Title"] = "Home Page"; @* Đặt tiêu đề trang là Home Page *@
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --th-bg: #FAF8F5;
        --th-primary: #8B5E3C;
        --th-secondary: #D9C3B0;
        --th-border: #EEE7E1;
        --th-text-main: #2C2C2C;
        --th-text-sub: #8A817C;
        --th-danger: #F44336;
        --th-warning: #FFB300;
        --th-success: #4CAF50;
    }

    .admin-wrapper {
        font-family: 'Inter', sans-serif;
        background-color: var(--th-bg);
        padding: 32px;
        min-height: 100vh;
    }

    .page-title {
        font-size: 42px;
        font-weight: 700;
        color: var(--th-text-main);
        margin-bottom: 8px;
        letter-spacing: -1px;
    }

    .page-subtitle {
        font-size: 16px;
        color: var(--th-text-sub);
        margin-bottom: 32px;
    }

    .th-card {
        background-color: #FFFFFF;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.04);
        border: 1px solid var(--th-border);
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    
    .th-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(0,0,0,0.08);
    }

    .th-card-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-bottom: 1px solid var(--th-border);
    }

    .th-card-body {
        padding: 24px;
    }

    .th-badge {
        background-color: #F8F3ED;
        color: var(--th-primary);
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
        margin-bottom: 12px;
    }

    .th-card-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--th-text-main);
        margin-bottom: 12px;
        line-height: 1.4;
    }

    .th-card-text {
        font-size: 14px;
        color: var(--th-text-sub);
        margin-bottom: 20px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .th-btn-read {
        height: 36px;
        border-radius: 10px;
        padding: 0 16px;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        background-color: transparent;
        border: 1px solid var(--th-primary);
        color: var(--th-primary);
        text-decoration: none;
    }

    .th-btn-read:hover {
        background-color: var(--th-primary);
        color: #FFFFFF;
    }

    .th-card-footer {
        padding: 16px 24px;
        background-color: #FDFBFA;
        border-top: 1px solid var(--th-border);
        font-size: 13px;
        color: var(--th-text-sub);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
</style>

<div class="admin-wrapper">
    <div class="mb-5 text-center">
        <h1 class="page-title" style="color: var(--th-primary);">NGUYỄN QUỲNH THẢO VY</h1>
        <p class="page-subtitle">Learn about <a href="https://learn.microsoft.com/aspnet/core" style="color: var(--th-primary); font-weight: 600;">building Web apps with ASP.NET Core</a>.</p>
    </div>

    <div>
        <h2 class="mb-4 fw-bold" style="font-size: 24px; color: var(--th-text-main);">Tin tức mới nhất</h2>
        
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="th-card h-100 d-flex flex-column">
                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? Url.Content("~/images/placeholder.png") : item.ImageUrl)" class="th-card-img" alt="Thumbnail">
                        <div class="th-card-body flex-grow-1">
                            <span class="th-badge">@item.Category?.Name</span>
                            <h5 class="th-card-title">@item.Title</h5>
                            @{
                                var plainText = !string.IsNullOrEmpty(item.Content) 
                                    ? System.Text.RegularExpressions.Regex.Replace(item.Content, "<.*?>", string.Empty) 
                                    : string.Empty;
                            }
                            <p class="th-card-text" title="@plainText">@plainText</p>
                            <a href="/Post/Details/@item.Id" class="th-btn-read">Đọc tiếp <i class="bi bi-arrow-right"></i></a>
                        </div>
                        <div class="th-card-footer">
                            <span><i class="bi bi-calendar3 me-1"></i> Ngày đăng:</span>
                            <span class="fw-medium">@item.CreatedDate.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
