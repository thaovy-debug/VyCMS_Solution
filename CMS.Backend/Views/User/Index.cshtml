@*
Sinh vien:Nguyễn Quỳnh Thảo Vy
Ma sv: 2123110158
Lop:CCQ2311E
Mo ta: Giao diện quản lý thành viên (Đã áp dụng Layout Admin quản trị, phân biệt màu sắc badge của Admin và Editor), 
Ngay thuc hien: 15/05/2026
*@
@model IEnumerable<CMS.Data.Entities.User>
@* Khai báo Model nhận danh sách thực thể người dùng *@
@{
    Layout = "_LayoutAdmin"; @* Áp dụng layout quản trị Admin *@
}

<div class="py-4"> @* Vùng đệm dọc cho trang *@
    <div class="d-flex justify-content-between align-items-center mb-3"> @* Bố cục căn ngang hai phần tử *@
        <h2 class="text-dark">QUẢN LÝ THÀNH VIÊN</h2> @* Tiêu đề quản lý thành viên *@
        <a asp-action="Create" class="btn btn-success"> @* Nút thêm thành viên mới *@
            <i class="bi bi-plus-circle"></i> Thêm thành viên mới @* Biểu tượng và nhãn nút *@
        </a> @* Kết thúc nút thêm *@
    </div> @* Kết thúc tiêu đề *@

    <table class="table table-striped table-bordered"> @* Thẻ bảng kẻ sọc và viền ngoài của Bootstrap *@
        <thead class="table-light"> @* Phần đầu bảng màu sáng *@
            <tr> @* Dòng tiêu đề *@
                <th style="width:60px">ID</th> @* Cột ID độ rộng cố định 60px *@
                <th>Tên Đăng Nhập</th> @* Cột tài khoản *@
                <th>Họ Và Tên</th> @* Cột họ tên đầy đủ *@
                <th>Quyền Hạn</th> @* Cột vai trò *@
                <th style="width:150px">Thao Tác</th> @* Cột thao tác rộng 150px *@
            </tr> @* Đóng dòng *@
        </thead> @* Đóng đầu *@
        <tbody> @* Phần thân chứa dữ liệu các tài khoản *@
            @foreach (var user in Model) @* Vòng lặp duyệt qua danh sách người dùng *@
            {
                <tr> @* Dòng chứa thông tin của một người dùng *@
                    <td>@user.Id</td> @* Ô hiển thị ID *@
                    <td>@user.Username</td> @* Ô hiển thị tài khoản đăng nhập *@
                    <td>@user.FullName</td> @* Ô hiển thị tên đầy đủ *@
                    <td> @* Ô hiển thị quyền hạn dạng badge *@
                        @if (!string.IsNullOrEmpty(user.Role)) @* Kiểm tra vai trò không bị trống *@
                        {
                            @if (user.Role == "Admin") @* Quyền Admin hiển thị màu đỏ *@
                            {
                                <span class="badge bg-danger">@user.Role</span>
                            }
                            else if (user.Role == "Editor") @* Quyền Editor hiển thị màu vàng *@
                            {
                                <span class="badge bg-warning text-dark">@user.Role</span>
                            }
                            else if (user.Role == "Moderator") @* Quyền Moderator hiển thị màu xanh lơ *@
                            {
                                <span class="badge bg-info text-dark">@user.Role</span>
                            }
                            else @* Các quyền khác (như User) hiển thị màu xám *@
                            {
                                <span class="badge bg-secondary">@user.Role</span>
                            }
                        }
                    </td> @* Đóng ô quyền *@
                    <td> @* Ô chứa các nút thao tác sửa xóa *@
                        @* Nút sửa tài khoản *@
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning">Sửa</a>
                        
                        @* Nút xóa tài khoản *@
                        <a asp-action="Delete" asp-route-id="@user.Id"
                           class="btn btn-sm btn-outline-danger"
                           onclick="return confirm('Bạn có chắc chắn muốn xóa thành viên @user.Username không?')">Xóa</a>
                    </td> @* Đóng ô thao tác *@
                </tr> @* Đóng dòng *@
            } @* Đóng vòng lặp *@
        </tbody> @* Đóng thân bảng *@
    </table> @* Đóng thẻ bảng *@
</div> @* Đóng khối py-4 *@