@model CMS.Data.Entities.User
@* Khai báo Model nhận dữ liệu thành viên từ form nhập liệu *@

@{
    Layout = "_LayoutAdmin"; @* Sử dụng Layout quản trị chung *@
    ViewData["Title"] = "Thêm thành viên"; @* Thiết lập tiêu đề trang cho layout *@
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --th-bg: #FAF8F5;
        --th-primary: #8B5E3C;
        --th-secondary: #D9C3B0;
        --th-border: #EEE7E1;
        --th-text-main: #2C2C2C;
        --th-text-sub: #8A817C;
        --th-danger: #F44336;
        --th-warning: #FFB300;
        --th-success: #4CAF50;
    }

    .admin-wrapper {
        font-family: 'Inter', sans-serif;
        background-color: var(--th-bg);
        padding: 32px;
        min-height: 100vh;
        display: flex;
        justify-content: center;
    }

    .page-title {
        font-size: 32px;
        font-weight: 700;
        color: var(--th-text-main);
        margin-bottom: 24px;
        text-align: center;
    }

    .th-card {
        background-color: #FFFFFF;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.04);
        border: 1px solid var(--th-border);
        padding: 40px;
        width: 100%;
        max-width: 600px;
    }

    .th-form-label {
        font-size: 14px;
        font-weight: 600;
        color: var(--th-text-main);
        margin-bottom: 8px;
    }

    .th-form-control {
        border-radius: 12px;
        border: 1px solid var(--th-border);
        padding: 12px 16px;
        font-size: 14px;
        color: var(--th-text-main);
        background-color: #FAF8F5;
        transition: all 0.2s ease;
        width: 100%;
        box-shadow: none !important;
    }

    .th-form-control:focus {
        border-color: var(--th-primary);
        background-color: #FFFFFF;
        outline: none;
    }
    
    .th-form-control::placeholder {
        color: #BDB5AF;
    }

    .th-btn {
        height: 48px;
        border-radius: 12px;
        padding: 0 24px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
        text-decoration: none;
    }

    .th-btn-primary {
        background-color: var(--th-primary);
        color: #FFFFFF;
    }

    .th-btn-primary:hover {
        background-color: #724c30;
        color: #FFFFFF;
    }

    .th-btn-outline {
        background-color: transparent;
        border: 1px solid #BDB5AF;
        color: var(--th-text-sub);
    }

    .th-btn-outline:hover {
        border-color: var(--th-text-main);
        color: var(--th-text-main);
    }
</style>

<div class="admin-wrapper">
    <div>
        <h1 class="page-title">Thêm Thành Viên Mới</h1>
        
        <div class="th-card">
            <form asp-action="Create" method="post">
                <div class="mb-4">
                    <label class="th-form-label">Tên đăng nhập (Username)</label>
                    <input asp-for="Username" class="th-form-control" placeholder="Ví dụ: admin_thai" required />
                </div>
                
                <div class="mb-4">
                    <label class="th-form-label">Mật khẩu</label>
                    <input asp-for="PasswordHash" type="password" class="th-form-control" placeholder="Nhập mật khẩu..." required />
                </div>
                
                <div class="mb-4">
                    <label class="th-form-label">Họ và Tên</label>
                    <input asp-for="FullName" class="th-form-control" placeholder="Nguyễn Văn A" required />
                </div>
                
                <div class="mb-5">
                    <label class="th-form-label">Vai trò (Role)</label>
                    <select asp-for="Role" class="th-form-control form-select" required>
                        <option value="">-- Chọn quyền hạn --</option>
                        <option value="Admin">Quản trị viên (Admin)</option>
                        <option value="Editor">Biên tập viên (Editor)</option>
                    </select>
                </div>
                
                <div class="d-flex gap-3">
                    <button type="submit" class="th-btn th-btn-primary flex-grow-1">Lưu thành viên</button>
                    <a asp-action="Index" class="th-btn th-btn-outline flex-grow-1">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>
