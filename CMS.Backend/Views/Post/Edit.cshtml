@model CMS.Data.Entities.Post
@* Khai báo Model kiểu Post chứa dữ liệu bài viết cần chỉnh sửa *@

@{
    Layout = "_LayoutAdmin"; @* Sử dụng Layout quản trị chung *@
    ViewData["Title"] = "Chỉnh sửa bài viết"; @* Thiết lập tiêu đề trang cho Layout *@
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --th-bg: #FAF8F5;
        --th-primary: #8B5E3C;
        --th-secondary: #D9C3B0;
        --th-border: #EEE7E1;
        --th-text-main: #2C2C2C;
        --th-text-sub: #8A817C;
        --th-danger: #F44336;
        --th-warning: #FFB300;
        --th-success: #4CAF50;
    }

    .admin-wrapper {
        font-family: 'Inter', sans-serif;
        background-color: var(--th-bg);
        padding: 32px;
        min-height: 100vh;
    }

    .page-title {
        font-size: 32px;
        font-weight: 700;
        color: var(--th-text-main);
        margin-bottom: 24px;
    }

    .th-card {
        background-color: #FFFFFF;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.04);
        border: 1px solid var(--th-border);
        padding: 32px;
    }

    .th-form-label {
        font-size: 14px;
        font-weight: 600;
        color: var(--th-text-main);
        margin-bottom: 8px;
    }

    .th-form-control {
        border-radius: 12px;
        border: 1px solid var(--th-border);
        padding: 12px 16px;
        font-size: 14px;
        color: var(--th-text-main);
        background-color: #FAF8F5;
        transition: all 0.2s ease;
        width: 100%;
        box-shadow: none !important;
    }

    .th-form-control:focus {
        border-color: var(--th-primary);
        background-color: #FFFFFF;
        outline: none;
    }
    
    .th-form-control::placeholder {
        color: #BDB5AF;
    }

    .th-btn {
        height: 48px;
        border-radius: 12px;
        padding: 0 24px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
        text-decoration: none;
    }

    .th-btn-warning {
        background-color: var(--th-warning);
        color: #FFFFFF;
    }

    .th-btn-warning:hover {
        background-color: #E6A100;
        color: #FFFFFF;
    }

    .th-btn-outline {
        background-color: transparent;
        border: 1px solid #BDB5AF;
        color: var(--th-text-sub);
    }

    .th-btn-outline:hover {
        border-color: var(--th-text-main);
        color: var(--th-text-main);
    }

    /* CKEditor customization */
    .ck-editor__editable_inline {
        min-height: 400px;
        border-radius: 0 0 12px 12px !important;
    }
    .ck-toolbar {
        border-radius: 12px 12px 0 0 !important;
        background-color: #FDFBFA !important;
        border-color: var(--th-border) !important;
    }
    .ck.ck-editor {
        border-radius: 12px;
        border: 1px solid var(--th-border);
    }
</style>

<div class="admin-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title mb-0">Chỉnh Sửa Bài Viết</h1>
        <a asp-action="Index" class="th-btn th-btn-outline">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>
    
    <div class="th-card">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />

            <div class="row g-5">
                <div class="col-md-8">
                    <div class="mb-4">
                        <label class="th-form-label">Tiêu đề bài viết</label>
                        <input asp-for="Title" class="th-form-control" placeholder="Nhập tiêu đề..." required />
                        <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label class="th-form-label">Nội dung chi tiết</label>
                        <textarea asp-for="Content" class="th-form-control" rows="15" placeholder="Viết nội dung tại đây..."></textarea>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="th-card" style="background-color: #FDFBFA; padding: 24px; border-radius: 16px;">
                        <div class="mb-4">
                            <label class="th-form-label">Chuyên mục</label>
                            <select asp-for="CategoryId" class="th-form-control form-select" asp-items="ViewBag.CategoryList" required>
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="th-form-label">Ảnh đại diện hiện tại</label>
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="mb-3">
                                    <img src="@Model.ImageUrl" alt="Current Image" style="width: 100%; height: 160px; object-fit: cover; border-radius: 12px; border: 1px solid var(--th-border);" />
                                </div>
                            }
                            <input type="file" name="uploadImage" class="th-form-control" accept="image/*" />
                            <small class="text-muted d-block mt-2" style="font-size: 12px;">Tải file lên nếu muốn thay đổi ảnh đại diện.</small>
                        </div>

                        <div class="mb-4">
                            <label class="th-form-label">Đường dẫn ảnh (URL)</label>
                            <input asp-for="ImageUrl" class="th-form-control" placeholder="Để trống nếu đã tải ảnh lên ở trên..." />
                        </div>

                        <div class="mb-4">
                            <label class="th-form-label">Ngày đăng</label>
                            <input asp-for="CreatedDate" type="date" class="th-form-control" value="@Model.CreatedDate.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>

                    <div class="d-grid gap-3 mt-4">
                        <button type="submit" class="th-btn th-btn-warning w-100" style="height: 56px; font-size: 16px;">
                            <i class="bi bi-cloud-arrow-up"></i> Cập nhật thay đổi
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts { @* Định nghĩa Section Script *@
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script> @* Tải thư viện CKEditor 5 CDN *@

    <script>
        // Kích hoạt trình soạn thảo giàu tính năng (Rich Text Editor) cho thẻ textarea có id là 'Content'
        ClassicEditor
            .create(document.querySelector('#Content'), {
                ckfinder: {
                    uploadUrl: '/Post/UploadImage'
                }
            })
            .catch(error => {
                console.error(error); // Ghi nhận lỗi ra console của trình duyệt nếu có lỗi xảy ra
            });
    </script>
}
