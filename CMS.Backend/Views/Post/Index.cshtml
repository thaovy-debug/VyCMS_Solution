@model IEnumerable<CMS.Data.Entities.Post>
<div class="py-4">
    <h2 class="text-danger fw-bold">DANH SÁCH BÀI VIẾT MỚI NHẤT</h2>

    <div class="row g-3 mt-3">
        @foreach (var post in Model)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <img src="@(string.IsNullOrEmpty(post.ImageUrl) ? Url.Content("~/images/placeholder.png") : post.ImageUrl)"
                         class="card-img-top" alt="thumbnail" style="object-fit:cover;height:180px" />
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-info text-dark">@post.Category?.Name</span>
                        <h5 class="card-title">
                            @Html.DisplayFor(m => post.Title)
                        </h5>
                        <p class="card-text text-truncate" style="max-height:3.6rem;">
                            @Html.Raw(post.Content)
                        </p>
                        <p class="text-muted small mt-auto">
                            Ngày đăng: @post.CreatedDate.ToString("dd/MM/yyyy")
                        </p>
                        <a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-outline-primary mt-2">
                            Xem chi tiết
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
