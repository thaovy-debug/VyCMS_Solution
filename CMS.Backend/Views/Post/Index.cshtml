@*
Sinh vien:Nguyễn Quỳnh Thảo Vy
Ma sv: 2123110158
Lop:CCQ2311E
Mo ta: Giao diện hiển thị danh sách bài viết quản trị (Đã bổ sung Layout quản trị, nút thêm, sửa và xóa bài viết), 
Ngay thuc hien: 15/05/2026
*@
@model IEnumerable<CMS.Data.Entities.Post>
@* Khai báo Model nhận danh sách bài viết từ CSDL *@
@{
    Layout = "_LayoutAdmin"; @* Sử dụng Layout quản trị chung vừa thiết lập *@
}

<div class="container mt-4"> @* Vùng chứa chính, khoảng cách trên mt-4 *@
    <div class="d-flex justify-content-between align-items-center mb-3"> @* Bố cục flex căn đều hai bên *@
        <h2 class="text-dark">DANH SÁCH BÀI VIẾT</h2> @* Tiêu đề danh sách màu tối *@
        <a asp-action="Create" class="btn btn-success"> @* Nút bấm liên kết sang Action Create tạo bài viết *@
            <i class="bi bi-plus-circle"></i> Thêm bài viết mới @* Biểu tượng dấu cộng và nhãn nút *@
        </a> @* Kết thúc nút thêm bài viết *@
    </div> @* Kết thúc vùng tiêu đề *@
    <div class="row"> @* Dòng lưới chứa các cột thẻ bài viết *@
        @foreach (var item in Model) @* Vòng lặp duyệt qua từng bài viết trong Model *@
        {
            <div class="col-md-4 mb-3"> @* Cột chiếm 4/12 độ rộng màn hình md, margin bottom mb-3 *@
                <div class="card shadow-sm"> @* Thẻ card có bóng mờ nhẹ *@
                    <img src="@item.ImageUrl" class="card-img-top" alt="Thumbnail" style="object-fit:cover;height:180px"> @* Ảnh đại diện bài viết với chiều cao cố định và tự co giãn *@
                    <div class="card-body"> @* Thân thẻ card *@
                        <span class="badge bg-info text-dark">@item.Category?.Name</span> @* Nhãn hiển thị tên chuyên mục, phòng hờ Category null *@
                        <h5 class="card-title text-primary">@item.Title</h5> @* Tiêu đề bài viết màu xanh *@
                        @{
                            // Loại bỏ các thẻ HTML để lấy văn bản thuần túy giúp căn chỉnh hiển thị 1 dòng sạch sẽ
                            var plainText = !string.IsNullOrEmpty(item.Content) 
                                ? System.Text.RegularExpressions.Regex.Replace(item.Content, "<.*?>", string.Empty) 
                                : string.Empty;
                        }
                        <p class="card-text text-truncate" title="@plainText">@plainText</p> @* Nội dung bài viết hiển thị thu gọn một dòng *@
                        <p class="text-muted small mb-1">Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")</p> @* Hiển thị ngày đăng định dạng dd/MM/yyyy *@
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input chk-post-visible" type="checkbox" data-id="@item.Id" @(item.IsVisible ? "checked" : "")>
                            <label class="form-check-label small text-muted font-weight-bold">Hiển thị web</label>
                        </div>
                        @* Nút xem chi tiết bài viết *@
                        <a href="/Post/Details/@item.Id" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                        
                        @* Nút sửa bài viết theo Id *@
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Sửa</a>
                            
                        @* Nút xóa bài viết theo Id *@
                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger"
                           onclick="return confirm('Chúng ta có chắc chắn muốn xóa bài viết này không?')">
                            <i class="bi bi-trash"></i> Xóa
                        </a>
                    </div> @* Kết thúc thân thẻ *@
                </div> @* Kết thúc thẻ *@
            </div> @* Kết thúc cột *@
        } @* Kết thúc vòng lặp *@
    </div> @* Kết thúc dòng *@
</div> @* Kết thúc vùng chứa *@

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.chk-post-visible').change(function () {
                var id = $(this).data('id');
                var isChecked = $(this).is(':checked');
                $.post('/Post/ToggleVisible', { id: id, isVisible: isChecked }, function (res) {
                    if (!res.success) {
                        alert("Lỗi khi cập nhật trạng thái hiển thị!");
                    }
                });
            });
        });
    </script>
}
