@model CMS.Data.Entities.Post
@* Khai báo Model kiểu Post để hiển thị thông tin bài viết chi tiết *@
@{
    Layout = "_LayoutAdmin"; @* Sử dụng Layout quản trị chung *@
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --th-bg: #FAF8F5;
        --th-primary: #8B5E3C;
        --th-secondary: #D9C3B0;
        --th-border: #EEE7E1;
        --th-text-main: #2C2C2C;
        --th-text-sub: #8A817C;
        --th-danger: #F44336;
        --th-warning: #FFB300;
        --th-success: #4CAF50;
    }

    .admin-wrapper {
        font-family: 'Inter', sans-serif;
        background-color: var(--th-bg);
        padding: 32px;
        min-height: 100vh;
    }

    .page-title {
        font-size: 32px;
        font-weight: 700;
        color: var(--th-text-main);
        margin-bottom: 24px;
    }

    .th-card {
        background-color: #FFFFFF;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.04);
        border: 1px solid var(--th-border);
        padding: 32px;
    }

    .th-btn {
        height: 48px;
        border-radius: 12px;
        padding: 0 24px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
        text-decoration: none;
    }

    .th-btn-outline {
        background-color: transparent;
        border: 1px solid #BDB5AF;
        color: var(--th-text-sub);
    }

    .th-btn-outline:hover {
        border-color: var(--th-text-main);
        color: var(--th-text-main);
    }
    
    .post-content {
        color: var(--th-text-main);
        line-height: 1.6;
        font-size: 15px;
    }
    
    .post-content img {
        max-width: 100%;
        height: auto;
        border-radius: 12px;
    }
</style>

<div class="admin-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title mb-0">Chi Tiết Bài Viết</h1>
        <a asp-action="Index" class="th-btn th-btn-outline">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>
    
    <div class="th-card">
        <h2 class="mb-3" style="color: var(--th-primary); font-weight: 700;">@Model.Title</h2>
        
        <div class="d-flex align-items-center gap-3 mb-4 pb-4 border-bottom" style="border-color: var(--th-border) !important;">
            <span style="background-color: #F8F3ED; color: var(--th-primary); padding: 6px 16px; border-radius: 8px; font-size: 13px; font-weight: 600;">
                <i class="bi bi-tag me-1"></i> Danh mục: @Model.Category?.Name
            </span>
            <span class="text-muted" style="font-size: 14px; font-weight: 500;">
                <i class="bi bi-calendar3 me-1"></i> Ngày đăng: @Model.CreatedDate.ToString("dd/MM/yyyy")
            </span>
        </div>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="mb-4">
                <img src="@Model.ImageUrl" alt="Thumbnail" style="width: 100%; max-height: 500px; object-fit: cover; border-radius: 16px; border: 1px solid var(--th-border);" />
            </div>
        }

        <div class="post-content mt-4">
            @Html.Raw(Model.Content)
        </div>
    </div>
</div>
