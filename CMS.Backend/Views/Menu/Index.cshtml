@model IEnumerable<CMS.Data.Entities.Menu>

@{
    ViewData["Title"] = "Quản lý Menu";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Quản lý Menu</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
        <li class="breadcrumb-item active">Menu</li>
    </ol>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-table me-1"></i>
                Danh sách Menu
            </div>
            <a asp-action="Create" class="btn btn-primary btn-sm">Thêm mới Menu</a>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped" id="datatablesSimple">
                <thead>
                    <tr>
                        <th>Tên Menu</th>
                        <th>Đường dẫn (Link)</th>
                        <th>Thứ tự</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.Link)</td>
                            <td>@Html.DisplayFor(modelItem => item.OrderIndex)</td>
                            <td>
                                @if (item.IsHidden)
                                {
                                    <span class="badge bg-secondary">Đang ẩn</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Đang hiện</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                                
                                <form asp-action="ToggleHide" asp-route-id="@item.Id" method="post" style="display:inline;">
                                    <button type="submit" class="btn @(item.IsHidden ? "btn-info" : "btn-secondary") btn-sm">
                                        @(item.IsHidden ? "Hiện" : "Ẩn")
                                    </button>
                                </form>

                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa menu này không?');">
                                    <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
