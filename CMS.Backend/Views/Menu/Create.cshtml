@model CMS.Data.Entities.Menu

@{
    ViewData["Title"] = "Thêm mới Menu";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    :root {
        --th-bg: #FAF8F5;
        --th-primary: #8B5E3C;
        --th-secondary: #D9C3B0;
        --th-border: #EEE7E1;
        --th-text-main: #2C2C2C;
        --th-text-sub: #8A817C;
        --th-danger: #F44336;
        --th-warning: #FFB300;
        --th-success: #4CAF50;
    }

    .admin-wrapper {
        font-family: 'Inter', sans-serif;
        background-color: var(--th-bg);
        padding: 32px;
        min-height: 100vh;
    }

    .page-title {
        font-size: 32px;
        font-weight: 700;
        color: var(--th-text-main);
        margin-bottom: 24px;
    }

    .th-card {
        background-color: #FFFFFF;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.04);
        border: 1px solid var(--th-border);
        padding: 32px;
        max-width: 600px;
    }

    .th-form-label {
        font-size: 14px;
        font-weight: 600;
        color: var(--th-text-main);
        margin-bottom: 8px;
    }

    .th-form-control {
        border-radius: 12px;
        border: 1px solid var(--th-border);
        padding: 12px 16px;
        font-size: 14px;
        color: var(--th-text-main);
        background-color: #FAF8F5;
        transition: all 0.2s ease;
        width: 100%;
        box-shadow: none !important;
    }

    .th-form-control:focus {
        border-color: var(--th-primary);
        background-color: #FFFFFF;
        outline: none;
    }
    
    .th-form-control::placeholder {
        color: #BDB5AF;
    }

    .th-btn {
        height: 48px;
        border-radius: 12px;
        padding: 0 24px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
        text-decoration: none;
    }

    .th-btn-primary {
        background-color: var(--th-primary);
        color: white;
    }

    .th-btn-primary:hover {
        background-color: #724c30;
        color: white;
    }

    .th-btn-outline {
        background-color: transparent;
        border: 1px solid #BDB5AF;
        color: var(--th-text-sub);
    }

    .th-btn-outline:hover {
        border-color: var(--th-text-main);
        color: var(--th-text-main);
    }
    
    .form-switch .form-check-input {
        width: 40px;
        height: 20px;
        margin-top: 0;
        cursor: pointer;
    }
    .form-switch .form-check-input:checked {
        background-color: var(--th-primary);
        border-color: var(--th-primary);
    }
</style>

<div class="admin-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title">Thêm Mới Menu</h1>
        <div class="d-flex gap-3">
            <a asp-action="Index" class="th-btn th-btn-outline">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </div>
    
    <div class="th-card">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            
            <div class="mb-4">
                <label asp-for="Name" class="th-form-label">Tên Menu</label>
                <input asp-for="Name" class="th-form-control" placeholder="Ví dụ: Sản phẩm, Giới thiệu..." required />
                <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Link" class="th-form-label">Đường dẫn (Link)</label>
                <input asp-for="Link" class="th-form-control" placeholder="Ví dụ: /san-pham, /gioi-thieu..." required />
                <span asp-validation-for="Link" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4">
                <label asp-for="OrderIndex" class="th-form-label">Thứ tự hiển thị</label>
                <input asp-for="OrderIndex" class="th-form-control" type="number" value="0" />
                <span asp-validation-for="OrderIndex" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4">
                <label class="th-form-label d-block mb-2">Trạng thái</label>
                <div class="form-check form-switch d-flex align-items-center gap-2">
                    <input class="form-check-input m-0" type="checkbox" asp-for="IsHidden" />
                    <label class="form-check-label m-0 text-muted" style="font-size: 14px;" asp-for="IsHidden">Ẩn Menu này (Không hiển thị)</label>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top" style="border-color: var(--th-border) !important;">
                <button type="submit" class="th-btn th-btn-primary px-5">
                    <i class="bi bi-plus-lg"></i> Lưu Menu
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
